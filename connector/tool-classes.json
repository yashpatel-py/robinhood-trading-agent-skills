{
  "$comment": "Hand-assigned class for every tool in connector/tools.snapshot.json (spec section C.3). The per-tool entries are the tools list; the other keys document the values and feed the generated connector-rules tables (R4, R15). Edit this file by hand; tools/sync_shared.py copies it to hooks/tool-classes.json, hooks/known-tools.txt and skills/robinhood-trading/scripts/tool_inventory.json. tools/check_drift.py verifies coverage, the money set, the review/place twins, account_param and paginates against the snapshot. Unofficial; not affiliated with Robinhood Markets, Inc.",
  "version": 1,
  "snapshot_captured_at": "2026-09-21",
  "classes": {
    "read": "Reads account, market, research, order, scanner, watchlist or alert data. Free to call; account reads still follow the read-scope rule (connector-rules R3).",
    "enroll_link": "Returns an enrollment or upgrade link and changes nothing. Call only when the rule for that link applies (R16).",
    "simulate": "Simulates without placing or saving (review_*, preview_*). Free, but only while the user is discussing that order or scan.",
    "write_confirm": "Changes non-money state on the Robinhood profile (scans, watchlists, alerts, read marks). One-line confirmation first (R7), except `mark_alerts_read` on exactly the `alert_log_ids` just relayed: call it without asking, scheduled passes included, and say so in one line afterwards.",
    "cancel": "Cancels an order or exercise, or deletes an alert. Explicit yes first, after stating which protection it removes (R6).",
    "money": "Places, exercises or replaces an order with real money. Never called in simulate-only mode; the plugin hook blocks it (R1)."
  },
  "field_values": {
    "family": "the connector/schemas/<family>.md file that holds the tool's verbatim description and input schema",
    "account_param": {
      "account_number": "key account_number, value = the alphanumeric account_number from get_accounts",
      "account_number=rhs_value": "key account_number, value = the numeric rhs_account_number from get_accounts",
      "rhs_account_number": "key rhs_account_number, value = rhs_account_number from get_accounts",
      "null": "no account parameter (profile-wide or market data)"
    },
    "paginates": {
      "next_url": "pass the cursor query parameter taken from the response's next URL",
      "next": "pass the value of the response's next field",
      "next_cursor": "pass the response's next_cursor (empty or null on the last page)",
      "next_offset": "pass the response's next_offset as offset",
      "null": "single page"
    },
    "place_twin": "on a simulate tool: the money tool it previews",
    "review_twin": "on a money tool: the simulate tool that previews it; exercise_option has none"
  },
