      "notes": "the 'source' VALUE ('consolidated') is assumed."},
    "equity_position": {"source": "guide", "tools": ["get_equity_positions"], "container": "positions",
      "fields": ["symbol", "instrument_id", "quantity", "intraday_quantity", "shares_available_for_sells",
                 "average_buy_price", "type", "shares_held_for_sells", "shares_held_for_options_collateral"],
      "assumed_fields": ["instrument_id", "shares_held_for_sells", "shares_held_for_options_collateral"],
      "notes": "Sellable quantity is shares_available_for_sells, not quantity (guide). The hold-breakdown names are assumed."},
    "tax_lot": {"source": "guide", "tools": ["get_equity_tax_lots"], "container": "tax_lots",
      "fields": ["open_lot_id", "quantity", "quantity_available", "is_selectable", "open_date", "term",
                 "cost_per_share", "tax_cost_basis"],
      "notes": "Newest-acquired first. Absent cost fields mean basis pending, never zero. The 'term' VALUES ('long_term', 'short_term') are assumed."},
    "equity_order": {"source": "guide", "tools": ["get_equity_orders", "get_advanced_orders"], "container": "orders",
      "fields": ["id", "symbol", "side", "type", "trigger", "state", "quantity", "dollar_based_amount",
                 "cumulative_quantity", "price", "stop_price", "average_price", "placed_agent", "created_at",
                 "last_transaction_at", "time_in_force", "market_hours", "reject_reason"],
