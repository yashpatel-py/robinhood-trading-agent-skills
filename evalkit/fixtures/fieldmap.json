                 "management_type", "affiliate", "state", "deactivated", "permanently_deactivated"],
      "notes": "brokerage_account_type 'ira_roth' for the Roth IRA is an assumed VALUE (IRA values were not observed)."},
    "portfolio": {"source": "captured", "tools": ["get_portfolio"],
      "fields": ["account_number", "total_value", "equity_value", "options_value", "futures_value", "event_contracts_value",
