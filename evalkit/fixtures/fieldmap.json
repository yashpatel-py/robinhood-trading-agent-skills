      "fields": ["buying_power", "unleveraged_buying_power", "display_currency"]},
    "portfolio_crypto_buying_power": {"source": "captured", "tools": ["get_portfolio"], "fields": ["buying_power"]},
    "equity_quote": {"source": "captured", "tools": ["get_equity_quotes", "review_equity_order"],
      "fields": ["symbol", "last_trade_price", "venue_last_trade_time", "last_non_reg_trade_price",
                 "venue_last_non_reg_trade_time", "adjusted_previous_close", "previous_close", "previous_close_date",
                 "bid_price", "venue_bid_time", "ask_price", "venue_ask_time", "has_traded", "state"]},
    "equity_close": {"source": "captured", "tools": ["get_equity_quotes"],
