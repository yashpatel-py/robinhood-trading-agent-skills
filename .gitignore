# Build output: tools/build_release.py (dist/zips, dist/chatgpt, dist/SHA256SUMS) and
# tools/build_variant.py (dist/variants/). Release assets are rebuilt from the tag, never committed.
/dist/

# Local eval runs. `claude plugin eval` results, reports and the CI scratch folder are published as
# workflow artifacts and release assets, not committed. evals/** itself IS committed (generated by
# evalkit/gen_evals.py; CI checks it is current).
/evals/results/
/eval-out/
/results-*.json
/report*.html

# Python and tool caches
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
.venv/

# OS and editor files
.DS_Store
