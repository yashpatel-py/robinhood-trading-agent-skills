{
  "script": "rh_time",
  "about": "ET <-> UTC conversion for created_at_gte lookbacks and fill timestamps, including both 2026-2027 DST boundaries.",
  "cases": [
    {"name": "spec: date 2026-10-17 is local midnight ET", "op": "to_utc", "input": {"date": "2026-10-17"},
     "expected": {"ok": true, "utc": "2026-10-17T04:00:00Z"}},
    {"name": "spec: explicit local midnight with tz", "op": "to_utc", "input": {"local": "2026-10-17T00:00:00", "tz": "America/New_York"},
     "match": "exact", "expected": {"ok": true, "utc": "2026-10-17T04:00:00Z", "local": "2026-10-17T00:00:00", "tz": "America/New_York"}},
    {"name": "midnight 2026-11-01 is still EDT", "op": "to_utc", "input": {"date": "2026-11-01"}, "expected": {"utc": "2026-11-01T04:00:00Z"}},
    {"name": "midnight 2026-11-02 is EST", "op": "to_utc", "input": {"date": "2026-11-02"}, "expected": {"utc": "2026-11-02T05:00:00Z"}},
    {"name": "midnight 2027-03-14 is still EST", "op": "to_utc", "input": {"date": "2027-03-14"}, "expected": {"utc": "2027-03-14T05:00:00Z"}},
    {"name": "midnight 2027-03-15 is EDT", "op": "to_utc", "input": {"date": "2027-03-15"}, "expected": {"utc": "2027-03-15T04:00:00Z"}},
    {"name": "repeated hour, earlier instant by default", "op": "to_utc", "input": {"local": "2026-11-01T01:30:00", "tz": "America/New_York"},
     "expected": {"utc": "2026-11-01T05:30:00Z", "notes": ["ambiguous wall time (DST change); earlier instant used"]}},
    {"name": "repeated hour, later instant with fold 1", "op": "to_utc", "input": {"local": "2026-11-01T01:30:00", "tz": "America/New_York", "fold": 1},
     "expected": {"utc": "2026-11-01T06:30:00Z"}},
    {"name": "skipped hour is rejected", "op": "to_utc", "input": {"local": "2027-03-14T02:30:00", "tz": "America/New_York"},
     "expected": {"ok": false, "errors": [{"code": "NONEXISTENT_LOCAL_TIME", "field": "local"}]}},
    {"name": "UTC wall time passes through", "op": "to_utc", "input": {"local": "2026-10-17T00:00:00", "tz": "UTC"},
     "expected": {"utc": "2026-10-17T00:00:00Z"}},
    {"name": "local with an offset is refused (it is not a wall time)", "op": "to_utc", "input": {"local": "2026-10-17T00:00:00-04:00"},
     "expected": {"ok": false, "errors": [{"code": "HAS_OFFSET"}]}},
    {"name": "nothing to convert", "op": "to_utc", "input": {}, "expected": {"ok": false, "errors": [{"code": "MISSING_FIELD"}]}},

    {"name": "fill at 01:05Z belongs to the previous ET day", "op": "to_et", "input": {"utc": "2026-11-17T01:05:00Z"},
     "match": "exact", "expected": {"ok": true, "et": "2026-11-16T20:05:00-05:00", "date_et": "2026-11-16", "offset": "-05:00"}},
    {"name": "summer offset", "op": "to_et", "input": {"utc": "2026-07-01T03:59:59Z"},
     "expected": {"et": "2026-06-30T23:59:59-04:00", "date_et": "2026-06-30", "offset": "-04:00"}},
    {"name": "a naive connector timestamp is read as UTC", "op": "to_et", "input": {"utc": "2026-11-17T01:05:00"},
     "expected": {"date_et": "2026-11-16"}},
    {"name": "garbage timestamp", "op": "to_et", "input": {"utc": "yesterday"}, "expected": {"ok": false, "errors": [{"code": "BAD_TIME"}]}}
  ]
}
