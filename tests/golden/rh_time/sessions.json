{
  "script": "rh_time",
  "about": "Regular-session boundaries, early close, holidays, weekends, DST and calendar expiry. Entries marked pinned are the build spec's starred calendar entries.",
  "cases": [
    {
      "name": "spec example: Monday 20:05 ET, user-stated",
      "op": "session",
      "input": {"now": "2026-11-16T20:05:00-05:00", "now_source": "user_stated"},
      "match": "exact",
      "expected": {
        "ok": true,
        "now_et": "2026-11-16T20:05:00-05:00",
        "now_utc": "2026-11-17T01:05:00Z",
        "trading_day": true,
        "holiday": null,
        "early_close": false,
        "regular_open_et": "09:30",
        "regular_close_et": "16:00",
        "in_regular_session": false,
        "session": "outside_regular_trading_day",
        "non_regular": {
          "windows_verified": false,
          "candidate": null,
          "ask_user": "Which session: extended_hours (pre-/post-market) or all_day_hours (24 Hour Market, overnight)?"
        },
        "next_regular_open_et": "2026-11-17T09:30:00-05:00",
        "calendar_valid_through": "2027-12-31",
        "now_source": "user_stated"
      }
    },
    {
      "name": "09:29:59 is before the open",
      "op": "session",
      "input": {"now": "2026-09-22T09:29:59-04:00", "now_source": "user_stated"},
      "expected": {"in_regular_session": false, "session": "outside_regular_trading_day", "next_regular_open_et": "2026-09-22T09:30:00-04:00"}
    },
    {
      "name": "09:30:00 is the open",
      "op": "session",
      "input": {"now": "2026-09-22T09:30:00-04:00", "now_source": "user_stated"},
      "expected": {"in_regular_session": true, "session": "regular", "non_regular": {"ask_user": null}, "next_regular_open_et": "2026-09-23T09:30:00-04:00"}
    },
    {
      "name": "15:59:59 is still regular",
      "op": "session",
      "input": {"now": "2026-09-22T15:59:59-04:00", "now_source": "user_stated"},
      "expected": {"in_regular_session": true, "session": "regular"}
    },
    {
      "name": "16:00:00 is the close (outside)",
      "op": "session",
      "input": {"now": "2026-09-22T16:00:00-04:00", "now_source": "user_stated"},
      "expected": {"in_regular_session": false, "session": "outside_regular_trading_day", "next_regular_open_et": "2026-09-23T09:30:00-04:00"}
    },
    {
      "name": "pinned: 2026-11-27 early close, 12:59:59 in session",
      "op": "session",
      "input": {"now": "2026-11-27T12:59:59-05:00", "now_source": "user_stated"},
      "expected": {"trading_day": true, "early_close": true, "regular_close_et": "13:00", "in_regular_session": true, "session": "regular"}
    },
    {
      "name": "pinned: 2026-11-27 early close, 13:00 is after the close",
      "op": "session",
      "input": {"now": "2026-11-27T13:00:00-05:00", "now_source": "user_stated"},
      "expected": {"early_close": true, "in_regular_session": false, "session": "outside_regular_trading_day", "next_regular_open_et": "2026-11-30T09:30:00-05:00"}
    },
    {
      "name": "pinned: 2026-11-26 Thanksgiving is closed",
      "op": "session",
      "input": {"now": "2026-11-26T11:00:00-05:00", "now_source": "user_stated"},
      "expected": {"trading_day": false, "holiday": "Thanksgiving Day", "session": "closed_day", "regular_open_et": null, "regular_close_et": null, "next_regular_open_et": "2026-11-27T09:30:00-05:00"}
    },
    {
      "name": "pinned: 2027-01-01 New Year's Day is closed",
      "op": "session",
      "input": {"now": "2027-01-01T10:00:00-05:00", "now_source": "user_stated"},
      "expected": {"trading_day": false, "holiday": "New Year's Day", "session": "closed_day", "next_regular_open_et": "2027-01-04T09:30:00-05:00"}
    },
    {
      "name": "Saturday is closed with no holiday name",
      "op": "session",
      "input": {"now": "2026-11-28T12:00:00-05:00", "now_source": "user_stated"},
      "expected": {"trading_day": false, "holiday": null, "session": "closed_day", "next_regular_open_et": "2026-11-30T09:30:00-05:00"}
    },
    {
      "name": "Christmas Eve 2026 is an early close",
      "op": "session",
      "input": {"now": "2026-12-24T13:30:00-05:00", "now_source": "user_stated"},
      "expected": {"early_close": true, "session": "outside_regular_trading_day", "next_regular_open_et": "2026-12-28T09:30:00-05:00"}
    },
    {
      "name": "Christmas Eve 2027 is a full closure (Christmas observed)",
      "op": "session",
      "input": {"now": "2027-12-24T11:00:00-05:00", "now_source": "user_stated"},
      "expected": {"trading_day": false, "holiday": "Christmas Day (observed)", "session": "closed_day"}
    },
    {
      "name": "quote timestamp with nanoseconds and Z",
      "op": "session",
      "input": {"now": "2026-11-16T14:35:12.123456789Z", "now_source": "quote_ts"},
      "expected": {"now_et": "2026-11-16T09:35:12-05:00", "session": "regular", "now_source": "quote_ts"}
    },
    {
      "name": "DST end: 2026-11-02 14:30Z is 09:30 EST (open)",
      "op": "session",
      "input": {"now": "2026-11-02T14:30:00Z", "now_source": "quote_ts"},
      "expected": {"now_et": "2026-11-02T09:30:00-05:00", "session": "regular"}
    },
    {
      "name": "DST end: 2026-11-02 13:30Z is 08:30 EST (before the open)",
      "op": "session",
      "input": {"now": "2026-11-02T13:30:00Z", "now_source": "quote_ts"},
      "expected": {"now_et": "2026-11-02T08:30:00-05:00", "session": "outside_regular_trading_day"}
    },
    {
      "name": "DST end: the Friday before, 13:30Z is 09:30 EDT (open)",
      "op": "session",
      "input": {"now": "2026-10-30T13:30:00Z", "now_source": "quote_ts"},
      "expected": {"now_et": "2026-10-30T09:30:00-04:00", "session": "regular"}
    },
    {
      "name": "DST end: the repeated hour on 2026-11-01 is ambiguous (earlier instant)",
      "op": "session",
      "input": {"now": "2026-11-01T01:30:00", "now_source": "user_stated"},
      "expected": {"now_et": "2026-11-01T01:30:00-04:00", "now_utc": "2026-11-01T05:30:00Z", "session": "closed_day",
                   "notes": ["now had no UTC offset; read as US Eastern wall time", "ambiguous wall time (DST change); the earlier instant was used"]}
    },
    {
      "name": "DST start: 2027-03-15 13:30Z is 09:30 EDT (open)",
      "op": "session",
      "input": {"now": "2027-03-15T13:30:00Z", "now_source": "quote_ts"},
      "expected": {"now_et": "2027-03-15T09:30:00-04:00", "session": "regular"}
    },
    {
      "name": "DST start: 2027-03-12 14:30Z is 09:30 EST (open)",
      "op": "session",
      "input": {"now": "2027-03-12T14:30:00Z", "now_source": "quote_ts"},
      "expected": {"now_et": "2027-03-12T09:30:00-05:00", "session": "regular"}
    },
    {
      "name": "DST start: 02:30 on 2027-03-14 does not exist",
      "op": "session",
      "input": {"now": "2027-03-14T02:30:00", "now_source": "user_stated"},
      "expected": {"ok": false, "errors": [{"code": "NONEXISTENT_LOCAL_TIME", "field": "now"}]}
    },
    {
      "name": "last covered day: next open is past the calendar",
      "op": "session",
      "input": {"now": "2027-12-31T17:00:00-05:00", "now_source": "user_stated"},
      "expected": {"ok": true, "trading_day": true, "next_regular_open_et": null, "notes": ["the next regular open is after calendar_valid_through"]}
    },
    {
      "name": "CALENDAR_EXPIRED after 2027-12-31",
      "op": "session",
      "input": {"now": "2028-01-03T10:00:00-05:00", "now_source": "user_stated"},
      "match": "exact",
      "expected": {"ok": false, "errors": [{"code": "CALENDAR_EXPIRED", "field": "now", "msg": "2028-01-03 is after calendar_valid_through 2027-12-31; update the NYSE table in rh_time.py"}]}
    },
    {
      "name": "before the embedded calendar",
      "op": "session",
      "input": {"now": "2025-12-31T10:00:00-05:00", "now_source": "user_stated"},
      "expected": {"ok": false, "errors": [{"code": "CALENDAR_NOT_COVERED"}]}
    },
    {
      "name": "now without now_source is labeled unspecified",
      "op": "session",
      "input": {"now": "2026-09-22T10:00:00-04:00"},
      "expected": {"ok": true, "now_source": "unspecified"}
    },
    {
      "name": "bad now_source",
      "op": "session",
      "input": {"now": "2026-09-22T10:00:00-04:00", "now_source": "guess"},
      "expected": {"ok": false, "errors": [{"code": "BAD_ENUM", "field": "now_source"}]}
    },
    {
      "name": "date without a time is rejected for session",
      "op": "session",
      "input": {"now": "2026-09-22", "now_source": "user_stated"},
      "expected": {"ok": false, "errors": [{"code": "BAD_TIME", "field": "now"}]}
    }
  ]
}
