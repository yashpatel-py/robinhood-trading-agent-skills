{
  "script": "rh_time",
  "about": "Trading-day arithmetic, settlement (T+1 with bank holidays) and calendar expiry. The wash-sale dates here match the build spec's wash_sale golden cases.",
  "cases": [
    {"name": "pinned: next trading day on/after 2027-01-01 is 2027-01-04", "op": "next_trading_day",
     "input": {"date": "2027-01-01", "inclusive": true}, "match": "exact",
     "expected": {"ok": true, "date": "2027-01-04", "inclusive": true}},
    {"name": "pinned: after 2026-11-25 comes 2026-11-27 (Thanksgiving closed, early close still trades)", "op": "next_trading_day",
     "input": {"date": "2026-11-25"}, "expected": {"ok": true, "date": "2026-11-27", "inclusive": false}},
    {"name": "inclusive on a trading day returns the same day", "op": "next_trading_day",
     "input": {"date": "2026-12-17", "inclusive": true}, "expected": {"date": "2026-12-17"}},
    {"name": "wash-sale golden: sale 2026-12-31 -> rebuy date 2027-01-31 (Sunday) -> 2027-02-01", "op": "next_trading_day",
     "input": {"date": "2027-01-31", "inclusive": true}, "expected": {"date": "2027-02-01"}},
    {"name": "wash-sale golden: sale 2026-12-01 -> 2027-01-01 -> 2027-01-04", "op": "next_trading_day",
     "input": {"date": "2027-01-01", "inclusive": true}, "expected": {"date": "2027-01-04"}},
    {"name": "wash-sale golden: sale 2026-09-22 -> 2026-10-23 (Friday)", "op": "next_trading_day",
     "input": {"date": "2026-10-23", "inclusive": true}, "expected": {"date": "2026-10-23"}},
    {"name": "year end: after 2026-12-31 comes 2027-01-04", "op": "next_trading_day",
     "input": {"date": "2026-12-31"}, "expected": {"date": "2027-01-04"}},
    {"name": "next trading day past the calendar is CALENDAR_EXPIRED", "op": "next_trading_day",
     "input": {"date": "2027-12-31"}, "expected": {"ok": false, "errors": [{"code": "CALENDAR_EXPIRED"}]}},
    {"name": "bad date", "op": "next_trading_day",
     "input": {"date": "2026-02-30"}, "expected": {"ok": false, "errors": [{"code": "BAD_DATE", "field": "date"}]}},

    {"name": "add 31 calendar days across year end", "op": "add_days",
     "input": {"date": "2026-12-31", "days": 31}, "match": "exact", "expected": {"ok": true, "date": "2027-01-31"}},
    {"name": "wash window start: 2026-11-16 minus 30", "op": "add_days",
     "input": {"date": "2026-11-16", "days": -30}, "expected": {"date": "2026-10-17"}},
    {"name": "wash window end: 2026-11-16 plus 30 (days as a string)", "op": "add_days",
     "input": {"date": "2026-11-16", "days": "30"}, "expected": {"date": "2026-12-16"}},
    {"name": "add_days rejects a non-integer", "op": "add_days",
     "input": {"date": "2026-11-16", "days": "1.5"}, "expected": {"ok": false, "errors": [{"code": "BAD_INT"}]}},

    {"name": "trading days after 2026-11-20 through 2026-11-30", "op": "trading_days_between",
     "input": {"start": "2026-11-20", "end": "2026-11-30"},
     "expected": {"ok": true, "trading_days": 5, "first": "2026-11-23", "last": "2026-11-30"}},
    {"name": "same range including the start day", "op": "trading_days_between",
     "input": {"start": "2026-11-20", "end": "2026-11-30", "include_start": true},
     "expected": {"trading_days": 6, "first": "2026-11-20"}},
    {"name": "holiday season 2026-12-24 to 2027-01-04", "op": "trading_days_between",
     "input": {"start": "2026-12-24", "end": "2027-01-04"},
     "expected": {"trading_days": 5, "first": "2026-12-28", "last": "2027-01-04"}},
    {"name": "end before start", "op": "trading_days_between",
     "input": {"start": "2026-12-24", "end": "2026-12-01"}, "expected": {"ok": false, "errors": [{"code": "BAD_RANGE"}]}},

    {"name": "T+1 over Thanksgiving", "op": "settlement_date",
     "input": {"trade_date": "2026-11-25"}, "expected": {"ok": true, "settlement_date": "2026-11-27"}},
    {"name": "T+1 skips Columbus Day (NYSE open, banks closed)", "op": "settlement_date",
     "input": {"trade_date": "2026-10-09"},
     "expected": {"settlement_date": "2026-10-13", "notes": ["skipped 2026-10-12: Columbus Day (banks closed; NYSE open)"]}},
    {"name": "T+1 skips Veterans Day", "op": "settlement_date",
     "input": {"trade_date": "2026-11-10"}, "expected": {"settlement_date": "2026-11-12"}},
    {"name": "a trade on Veterans Day itself settles the next business day", "op": "settlement_date",
     "input": {"trade_date": "2026-11-11"}, "expected": {"trade_date_effective": "2026-11-11", "settlement_date": "2026-11-12"}},
    {"name": "T+1 from the Christmas Eve early close", "op": "settlement_date",
     "input": {"trade_date": "2026-12-24"}, "expected": {"settlement_date": "2026-12-28"}},
    {"name": "a Saturday date takes the next trading day as its trade date", "op": "settlement_date",
     "input": {"trade_date": "2026-11-28"},
     "expected": {"trade_date": "2026-11-28", "trade_date_effective": "2026-11-30", "settlement_date": "2026-12-01"}},
    {"name": "settlement past the calendar", "op": "settlement_date",
     "input": {"trade_date": "2027-12-31"}, "expected": {"ok": false, "errors": [{"code": "CALENDAR_EXPIRED"}]}},

    {"name": "calendar_info warns 60 days before expiry", "op": "calendar_info",
     "input": {"today": "2027-11-01"}, "expected": {"ok": true, "valid_through": "2027-12-31", "days_until_expiry": 60, "expiry_warning": true}},
    {"name": "calendar_info does not warn at 61 days", "op": "calendar_info",
     "input": {"today": "2027-10-31"}, "expected": {"days_until_expiry": 61, "expiry_warning": false}},
    {"name": "calendar_info lists the pinned entries", "op": "calendar_info",
     "input": {"today": "2026-09-22"},
     "expected": {"holidays": {"2026-11-26": "Thanksgiving Day", "2027-01-01": "New Year's Day"}, "early_closes": {"2026-11-27": "Day after Thanksgiving"},
                  "non_regular_windows": {"verified": false}}}
  ]
}
