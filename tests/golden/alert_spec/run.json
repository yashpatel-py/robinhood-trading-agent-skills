{
  "script": "alert_spec",
  "about": "Alert intent -> create_alert parameters. Families, bars and refusals follow the create_alert schema (verified 2026-09-22).",
  "cases": [
    {"name": "spec: price_crosses_sma 200/1d has no threshold", "op": "run",
     "input": {"symbol": "NVDA", "asset_class": "equity", "intent": {"kind": "price_crosses_sma", "period": 200, "bar": "1d"}},
     "match": "exact",
     "expected": {"ok": true,
                  "params": {"symbol": "NVDA", "condition_type": "price_crosses_sma", "indicator": {"period": 200, "interval_secs": 86400}, "asset_class": "equity"},
                  "explain": "Market price crosses the 200-bar daily SMA line (no threshold).",
                  "dedupe_key": "NVDA|equity|price_crosses_sma|200|86400",
                  "shape": "price_vs_line", "update_group": "sma",
                  "next": "get_alerts {symbol, asset_class} to dedupe, then a one-line confirmation, then create_alert. Alerts notify the user's phone; they do not trade."}},
    {"name": "spec: sma_crosses needs a threshold", "op": "run",
     "input": {"symbol": "NVDA", "asset_class": "equity", "intent": {"kind": "sma_crosses", "period": 50, "bar": "1d"}},
     "expected": {"ok": false, "errors": [{"code": "THRESHOLD_REQUIRED", "field": "intent.threshold"}]}},
    {"name": "sma_crosses with a threshold is the SMA's own value", "op": "run",
     "input": {"symbol": "NVDA", "asset_class": "equity", "intent": {"kind": "sma_crosses", "period": 50, "bar": "1d", "threshold": "180"}},
     "expected": {"ok": true, "params": {"condition_type": "sma_crosses", "threshold": "180", "indicator": {"period": 50, "interval_secs": 86400}},
                  "shape": "indicator_value", "update_group": "sma"}},
    {"name": "a threshold on a price-vs-line kind is refused with the sibling named", "op": "run",
     "input": {"symbol": "NVDA", "asset_class": "equity", "intent": {"kind": "price_above_ema", "period": 21, "bar": "1h", "threshold": "180"}},
     "expected": {"ok": false, "errors": [{"code": "THRESHOLD_NOT_ALLOWED", "msg": "price_above_ema compares against a line and takes no threshold; for a number use ema_above"}]}},
    {"name": "spec: VWAP with 3600 is an error", "op": "run",
     "input": {"symbol": "SPY", "asset_class": "equity", "intent": {"kind": "price_above_vwap", "bar": "1h"}},
     "expected": {"ok": false, "errors": [{"code": "VWAP_300_ONLY"}]}},
    {"name": "VWAP defaults to its only bar size", "op": "run",
     "input": {"symbol": "SPY", "asset_class": "equity", "intent": {"kind": "price_below_vwap"}},
     "expected": {"ok": true, "params": {"indicator": {"interval_secs": 300}}, "notes": ["VWAP alerts use 5-minute bars (the only size supported)"]}},
    {"name": "VWAP by interval_secs 300", "op": "run",
     "input": {"symbol": "SPY", "asset_class": "equity", "intent": {"kind": "vwap_above", "interval_secs": 300, "threshold": "500"}},
     "expected": {"ok": true, "params": {"condition_type": "vwap_above", "threshold": "500", "indicator": {"interval_secs": 300}}}},
    {"name": "spec: crypto RSI is an error", "op": "run",
     "input": {"symbol": "BTC", "asset_class": "crypto", "intent": {"kind": "rsi_above", "threshold": "70", "period": 14, "bar": "1h"}},
     "expected": {"ok": false, "errors": [{"code": "CRYPTO_PRICE_ONLY"}]}},
    {"name": "crypto price alert", "op": "run",
     "input": {"symbol": "btc", "asset_class": "crypto", "intent": {"kind": "price_below", "threshold": "60000"}},
     "match": "exact",
     "expected": {"ok": true, "params": {"symbol": "BTC", "condition_type": "price_below", "threshold": "60000", "asset_class": "crypto"},
                  "explain": "Market price of BTC falls below $60000.", "dedupe_key": "BTC|crypto|price_below|60000", "shape": "price", "update_group": "price",
                  "next": "get_alerts {symbol, asset_class} to dedupe, then a one-line confirmation, then create_alert. Alerts notify the user's phone; they do not trade."}},
    {"name": "spec: golden cross is not expressible", "op": "run",
     "input": {"symbol": "AAPL", "asset_class": "equity", "intent": {"kind": "golden_cross"}},
     "expected": {"ok": false, "errors": [{"code": "NOT_EXPRESSIBLE", "field": "intent.kind"}]}},
    {"name": "percent change is not expressible", "op": "run",
     "input": {"symbol": "AAPL", "asset_class": "equity", "intent": {"kind": "percent_change", "threshold": "5"}},
     "expected": {"ok": false, "errors": [{"code": "NOT_EXPRESSIBLE"}]}},
    {"name": "volume is not expressible", "op": "run",
     "input": {"symbol": "AAPL", "asset_class": "equity", "intent": {"kind": "volume_above", "threshold": "1000000"}},
     "expected": {"ok": false, "errors": [{"code": "NOT_EXPRESSIBLE"}]}},
    {"name": "option contracts are not expressible", "op": "run",
     "input": {"symbol": "AMD261127C00165000", "intent": {"kind": "price_above", "threshold": "5"}},
     "expected": {"ok": false, "errors": [{"code": "NOT_EXPRESSIBLE", "field": "symbol"}]}},
    {"name": "indexes are not expressible", "op": "run",
     "input": {"symbol": "SPX", "asset_class": "equity", "intent": {"kind": "price_above", "threshold": "7000"}},
     "expected": {"ok": false, "errors": [{"code": "NOT_EXPRESSIBLE", "field": "symbol"}]}},
    {"name": "index asset class is not expressible", "op": "run",
     "input": {"symbol": "NDX", "asset_class": "index", "intent": {"kind": "price_above", "threshold": "25000"}},
     "expected": {"ok": false, "errors": [{"code": "NOT_EXPRESSIBLE"}]}},
    {"name": "spec: BTC without asset_class is ambiguous", "op": "run",
     "input": {"symbol": "BTC", "intent": {"kind": "price_below", "threshold": "60000"}},
     "expected": {"ok": false, "errors": [{"code": "AMBIGUOUS_CRYPTO_TICKER", "field": "asset_class"}]}},
    {"name": "ETH without asset_class is ambiguous", "op": "run",
     "input": {"symbol": "ETH", "intent": {"kind": "price_above", "threshold": "3000"}},
     "expected": {"ok": false, "errors": [{"code": "AMBIGUOUS_CRYPTO_TICKER"}]}},
    {"name": "a caller-supplied fixture list extends the ambiguous set", "op": "run",
     "input": {"symbol": "DOGE", "ambiguous_tickers": ["DOGE"], "intent": {"kind": "price_above", "threshold": "1"}},
     "expected": {"ok": false, "errors": [{"code": "AMBIGUOUS_CRYPTO_TICKER"}]}},
    {"name": "BTC as the equity (the ETF) is allowed when stated", "op": "run",
     "input": {"symbol": "BTC", "asset_class": "equity", "intent": {"kind": "price_below", "threshold": "40"}},
     "expected": {"ok": true, "params": {"symbol": "BTC", "asset_class": "equity"}}},
    {"name": "pair form implies crypto and is cut to the base code", "op": "run",
     "input": {"symbol": "ETH-USD", "intent": {"kind": "price_below", "threshold": "2000"}},
     "expected": {"ok": true, "params": {"symbol": "ETH", "asset_class": "crypto"}}},
    {"name": "plain equity default is stated", "op": "run",
     "input": {"symbol": "nvda", "intent": {"kind": "price_below", "threshold": "150.00"}},
     "expected": {"ok": true, "params": {"symbol": "NVDA", "threshold": "150.00", "asset_class": "equity"},
                  "dedupe_key": "NVDA|equity|price_below|150", "notes": ["asset_class set to equity (pass crypto for a coin)"]}},
    {"name": "RSI hourly", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "rsi_above", "threshold": "70", "period": 14, "bar": "hourly"}},
     "expected": {"ok": true, "params": {"indicator": {"period": 14, "interval_secs": 3600}},
                  "explain": "RSI(14) on hourly bars rises above 70 (the indicator's value vs your number, not price vs the line)."}},
    {"name": "RSI threshold over 100", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "rsi_below", "threshold": "130", "period": 14, "bar": "1d"}},
     "expected": {"ok": false, "errors": [{"code": "BAD_THRESHOLD"}]}},
    {"name": "Bollinger upper band", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_above_boll_upper", "period": 20, "std_dev": "2", "ma_type": "sma", "bar": "1d"}},
     "expected": {"ok": true, "params": {"indicator": {"period": 20, "std_dev": 2, "ma_type": "sma", "interval_secs": 86400}},
                  "dedupe_key": "AMD|equity|price_above_boll_upper|20|2|sma|86400"}},
    {"name": "Bollinger with a fractional std_dev", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_below_boll_lower", "period": 20, "std_dev": 2.5, "ma_type": "ema", "bar": "1w"}},
     "expected": {"ok": true, "params": {"indicator": {"std_dev": 2.5, "ma_type": "ema", "interval_secs": 604800}}}},
    {"name": "Bollinger needs all its fields", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_crosses_boll_mid", "period": 20, "bar": "1d"}},
     "expected": {"ok": false, "errors": [{"code": "MISSING_FIELD"}]}},
    {"name": "MACD crosses signal", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "macd_crosses_signal", "fast_period": 12, "slow_period": 26, "signal_period": 9, "bar": "1d"}},
     "expected": {"ok": true, "params": {"indicator": {"fast_period": 12, "slow_period": 26, "signal_period": 9, "interval_secs": 86400}},
                  "explain": "MACD(12,26,9) on daily bars crosses its signal line (no threshold)."}},
    {"name": "MACD periods are never assumed", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "macd_above_signal", "bar": "1d"}},
     "expected": {"ok": false, "errors": [{"code": "MISSING_FIELD", "field": "intent.fast_period"}]}},
    {"name": "MACD fast must be shorter than slow", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "macd_below_signal", "fast_period": 26, "slow_period": 12, "signal_period": 9, "bar": "1d"}},
     "expected": {"ok": false, "errors": [{"code": "BAD_VALUE"}]}},
    {"name": "SMA period is never assumed", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_below_sma", "bar": "1d"}},
     "expected": {"ok": false, "errors": [{"code": "MISSING_FIELD", "field": "intent.period"}]}},
    {"name": "bar size is never assumed", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_below_sma", "period": 50}},
     "expected": {"ok": false, "errors": [{"code": "MISSING_FIELD", "field": "intent.bar"}]}},
    {"name": "unsupported bar", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_below_sma", "period": 50, "bar": "15m"}},
     "expected": {"ok": false, "errors": [{"code": "BAD_BAR"}]}},
    {"name": "every bar size maps to its interval", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "ema_below", "period": 9, "bar": "30d", "threshold": "100"}},
     "expected": {"ok": true, "params": {"indicator": {"period": 9, "interval_secs": 2592000}}}},
    {"name": "an indicator on a price kind is refused", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_above", "threshold": "180", "period": 50, "bar": "1d"}},
     "expected": {"ok": false, "errors": [{"code": "INDICATOR_NOT_ALLOWED"}]}},
    {"name": "price kinds need a threshold", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_crosses"}},
     "expected": {"ok": false, "errors": [{"code": "THRESHOLD_REQUIRED"}]}},
    {"name": "threshold must be a decimal", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_above", "threshold": "about 180"}},
     "expected": {"ok": false, "errors": [{"code": "BAD_THRESHOLD"}]}},
    {"name": "a numeric threshold is emitted as a string", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_above", "threshold": 180.5}},
     "expected": {"ok": true, "params": {"threshold": "180.5"}}},
    {"name": "unknown kind", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "equity", "intent": {"kind": "price_moons"}},
     "expected": {"ok": false, "errors": [{"code": "UNKNOWN_KIND"}]}},
    {"name": "bad asset class", "op": "run",
     "input": {"symbol": "AMD", "asset_class": "bond", "intent": {"kind": "price_above", "threshold": "1"}},
     "expected": {"ok": false, "errors": [{"code": "BAD_ENUM"}]}},

    {"name": "dedupe: identical enabled alert", "op": "dedupe",
     "input": {"candidate": {"symbol": "NVDA", "condition_type": "price_below", "threshold": "150.00", "asset_class": "equity"},
               "existing": [{"alert_id": "a-1", "asset_class": "equity", "symbol": "NVDA", "enabled": true, "condition_type": "price_below", "condition": {"target_price": "150"}},
                            {"alert_id": "a-2", "asset_class": "equity", "symbol": "NVDA", "enabled": true, "condition_type": "price_below", "condition": {"target_price": "140"}},
                            {"alert_id": "a-3", "asset_class": "equity", "symbol": "AMD", "enabled": true, "condition_type": "price_below", "condition": {"target_price": "150"}}]},
     "expected": {"ok": true, "key": "NVDA|equity|price_below|150",
                  "duplicates": [{"alert_id": "a-1", "enabled": true}],
                  "same_condition_other_level": [{"alert_id": "a-2"}],
                  "action": "an identical alert exists; do not create another"}},
    {"name": "dedupe: identical but disabled alert", "op": "dedupe",
     "input": {"candidate": {"symbol": "NVDA", "condition_type": "price_crosses_sma", "indicator": {"period": 200, "interval_secs": 86400}, "asset_class": "equity"},
               "existing": [{"alert_id": "a-9", "asset_class": "equity", "symbol": "NVDA", "enabled": false, "condition_type": "price_crosses_sma",
                             "condition": {"period": 200, "interval_secs": 86400}}]},
     "expected": {"ok": true, "duplicates": [{"alert_id": "a-9", "enabled": false}],
                  "action": "an identical alert exists but is disabled; offer update_alert {enabled: true} instead"}},
    {"name": "dedupe: nothing matches", "op": "dedupe",
     "input": {"candidate": {"symbol": "BTC", "condition_type": "price_below", "threshold": "60000", "asset_class": "crypto"},
               "existing": [{"alert_id": "a-1", "asset_class": "equity", "symbol": "BTC", "enabled": true, "condition_type": "price_below", "condition": {"target_price": "60000"}}]},
     "expected": {"ok": true, "duplicates": [], "same_condition_other_level": [], "action": "no identical alert; creating one is not a duplicate"}}
  ]
}
