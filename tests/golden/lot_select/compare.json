{
 "script": "lot_select",
 "about": "compare: each strategy's tax_lots array, realized $ and short/long split side by side; FIFO is labeled Robinhood's default; there is never a 'best' (build spec B.7.10).",
 "cases": [
  {
   "name": "TSLA: FIFO sells the long-term lot, highest cost the short-term lot",
   "op": "compare",
   "input": {
    "symbol": "TSLA",
    "sell_quantity": "20",
    "price": "262.00",
    "as_of": "2026-11-16",
    "lots": [
     {
      "open_lot_id": "L7",
      "open_date": "2026-06-02",
      "quantity_available": "20",
      "cost_per_share": "340.00"
     },
     {
      "open_lot_id": "L1",
      "open_date": "2025-03-10",
      "quantity_available": "20",
      "cost_per_share": "280.00"
     }
    ]
   },
   "expected": {
    "ok": true,
    "fifo_label": "Robinhood's default",
    "strategy_order": [
     "fifo",
     "highest_cost",
     "lowest_cost",
     "long_term_first",
     "losses_first"
    ],
    "strategies": {
     "fifo": {
      "tax_lots": [
       {
        "open_lot_id": "L1",
        "quantity": "20"
       }
      ],
      "realized_usd": "-360.00",
      "realized_short_usd": "0.00",
      "realized_long_usd": "-360.00",
      "lot_count": 1,
      "valid": true,
      "label": "Robinhood's default"
     },
     "highest_cost": {
      "tax_lots": [
       {
        "open_lot_id": "L7",
        "quantity": "20"
       }
      ],
      "realized_usd": "-1560.00",
      "realized_short_usd": "-1560.00",
      "realized_long_usd": "0.00"
     },
     "lowest_cost": {
      "tax_lots": [
       {
        "open_lot_id": "L1",
        "quantity": "20"
       }
      ],
      "realized_usd": "-360.00"
     },
     "long_term_first": {
      "tax_lots": [
       {
        "open_lot_id": "L1",
        "quantity": "20"
       }
      ]
     },
     "losses_first": {
      "tax_lots": [
       {
        "open_lot_id": "L7",
        "quantity": "20"
       }
      ],
      "realized_short_usd": "-1560.00"
     }
    }
   }
  },
