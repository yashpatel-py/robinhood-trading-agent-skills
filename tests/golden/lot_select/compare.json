        "quantity": "10"
       }
      ],
      "realized_short_usd": "-280.00",
      "realized_long_usd": "-380.00",
      "lots_detail": [
       {
        "open_lot_id": "R",
        "term": "long",
        "broker_term": "long",
        "date_term": "short",
        "term_agrees": false
       },
       {
        "open_lot_id": "G",
        "term": "short",
        "term_agrees": true,
        "long_term_on": "2027-08-02"
       }
      ],
      "warnings": [
       {
        "code": "TERM_DISAGREES"
       }
      ]
     },
     "long_term_first": {
      "tax_lots": [
       {
