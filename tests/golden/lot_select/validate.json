{
 "script": "lot_select",
 "about": "validate: the tax_lots array review_equity_order will accept (build spec B.7.10; review_equity_order schema).",
 "cases": [
  {
   "name": "valid two-lot array",
   "op": "validate",
   "input": {
    "sell_quantity": "25",
    "tax_lots": [
     {
      "open_lot_id": "L7",
      "quantity": "20"
     },
     {
      "open_lot_id": "L1",
      "quantity": "5"
     }
    ],
    "lots": [
     {
      "open_lot_id": "L7",
      "open_date": "2026-06-02",
      "quantity_available": "20",
      "cost_per_share": "340.00"
     },
     {
      "open_lot_id": "L1",
      "open_date": "2025-03-10",
      "quantity_available": "20",
      "cost_per_share": "280.00"
     }
    ],
    "order": {
     "side": "sell",
     "type": "limit",
     "market_hours": "extended_hours"
    }
   },
   "expected": {
    "ok": true,
    "valid": true,
    "errors": [],
    "sum": "25",
    "lot_count": 2
   }
  },
  {
   "name": "exact decimal sum: 0.1 + 0.2 = 0.3",
   "op": "validate",
   "input": {
    "sell_quantity": "0.3",
    "tax_lots": [
     {
      "open_lot_id": "L7",
      "quantity": "0.1"
     },
     {
      "open_lot_id": "L1",
      "quantity": "0.2"
     }
    ],
    "lots": [
     {
      "open_lot_id": "L7",
      "open_date": "2026-06-02",
      "quantity_available": "20",
      "cost_per_share": "340.00"
     },
     {
      "open_lot_id": "L1",
      "open_date": "2025-03-10",
      "quantity_available": "20",
      "cost_per_share": "280.00"
     }
    ],
    "order": {
     "side": "sell",
     "type": "market",
     "market_hours": "regular_hours"
    }
   },
   "expected": {
    "ok": true,
    "valid": true,
    "sum": "0.3"
   }
  },
  {
   "name": "sum mismatch",
   "op": "validate",
   "input": {
    "sell_quantity": "10",
    "tax_lots": [
     {
      "open_lot_id": "L7",
      "quantity": "9.999999"
     }
    ],
    "lots": [
     {
      "open_lot_id": "L7",
      "open_date": "2026-06-02",
      "quantity_available": "20",
      "cost_per_share": "340.00"
     },
     {
      "open_lot_id": "L1",
      "open_date": "2025-03-10",
      "quantity_available": "20",
      "cost_per_share": "280.00"
     }
    ],
    "order": {
     "side": "sell",
     "type": "limit"
    }
   },
   "expected": {
    "ok": true,
    "valid": false,
    "errors": [
     {
      "code": "TAX_LOTS_SUM_MISMATCH"
     }
    ]
   }
  },
