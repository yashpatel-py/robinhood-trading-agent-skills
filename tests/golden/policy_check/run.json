{
  "script": "policy_check",
  "about": "Soft [policy] limits. UNSET means not configured; a set limit that cannot be evaluated fails (POLICY_UNKNOWN). Household math: PLTR 238.00 + 312.40 = 550.40; positions-only total 14880.00 + 312.40 = 15192.40 -> 3.6%; with cash included the total stays 14880.00 -> 3.7%.",
  "orders": {
    "pltr_buy": {"tool": "review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "PLTR", "side": "buy", "type": "limit",
                                                           "quantity": "10", "limit_price": "31.24", "market_hours": "all_day_hours"}},
    "pltr_sell": {"tool": "review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "PLTR", "side": "sell", "type": "limit",
                                                            "quantity": "10", "limit_price": "31.18"}},
    "amd_spread": {"tool": "review_option_order", "params": {"account_number": "demo-X4F1", "chain_symbol": "AMD", "underlying_type": "equity",
                                                             "quantity": "2", "price": "2.20", "direction": "debit",
                                                             "legs": [{"option_id": "opt-a", "side": "buy", "position_effect": "open"},
                                                                      {"option_id": "opt-b", "side": "sell", "position_effect": "open"}]}},
    "amd_ratio": {"tool": "review_option_order", "params": {"account_number": "demo-X4F1", "chain_symbol": "AMD", "quantity": "2", "price": "0.40",
                                                            "direction": "debit",
                                                            "legs": [{"option_id": "opt-a", "side": "buy", "position_effect": "open", "ratio_quantity": 1},
                                                                     {"option_id": "opt-b", "side": "sell", "position_effect": "open", "ratio_quantity": 2}]}},
    "btc_buy": {"tool": "preview_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "BTC-USD", "side": "buy", "type": "market",
                                                           "dollar_amount": "100"}}
  },
  "cases": [
    {"name": "within every configured limit", "order": "pltr_buy",
     "input": {"policy": {"max_order_usd": "500.00", "max_symbol_pct_household": "10", "symbol_denylist": ["GME"],
                          "earnings_blackout_days": "3", "max_orders_per_day": "5", "allow_options": false,
                          "allowed_sessions": ["regular_hours", "all_day_hours"]},
               "estimate_usd": "312.40", "household": {"total_usd": "14880.00", "by_symbol": {"PLTR": "238.00"}},
               "earnings": {"PLTR": {"date": "2027-02-02", "verified": false}}, "orders_today": 1, "as_of": "2026-11-16"},
     "expected": {"ok": true, "pass": true, "violations": [],
                  "checks": [{"rule": "max_order_usd", "limit": "500.00", "actual": "312.40", "pass": true},
                             {"rule": "max_symbol_pct_household", "limit": "10", "actual": "3.6%", "pass": true},
                             {"rule": "symbol_denylist", "limit": ["GME"], "actual": "PLTR", "pass": true},
                             {"rule": "earnings_blackout_days", "limit": 3, "actual": "report 2027-02-02 in 78 days (unverified date)", "pass": true},
                             {"rule": "max_orders_per_day", "limit": 5, "actual": 2, "pass": true},
                             {"rule": "allow_options", "limit": false, "actual": "equity", "pass": true},
                             {"rule": "allowed_sessions", "limit": ["regular_hours", "all_day_hours"], "actual": "all_day_hours", "pass": true}],
                  "not_configured": ["symbol_allowlist", "allow_crypto", "max_option_contracts"], "symbol": "PLTR"}},
    {"name": "nothing configured passes and lists every rule", "order": "pltr_buy",
     "input": {"policy": {"max_order_usd": "UNSET", "symbol_allowlist": [], "allowed_sessions": []}},
     "expected": {"ok": true, "pass": true, "checks": [],
                  "not_configured": ["max_order_usd", "max_symbol_pct_household", "symbol_allowlist", "symbol_denylist", "earnings_blackout_days",
                                     "max_orders_per_day", "allow_options", "allow_crypto", "allowed_sessions", "max_option_contracts"]}},
    {"name": "no policy section at all", "order": "pltr_buy", "input": {},
     "expected": {"ok": true, "pass": true, "violations": []}},
    {"name": "order over the cap", "order": "pltr_buy",
     "input": {"policy": {"max_order_usd": "300"}, "estimate_usd": "312.40"},
     "expected": {"ok": true, "pass": false,
                  "violations": [{"rule": "max_order_usd", "code": "POLICY_CAP", "msg": "order estimate $312.40 is over your max order of $300.00"}]}},
    {"name": "exactly at the cap passes", "order": "pltr_buy",
     "input": {"policy": {"max_order_usd": "312.40"}, "estimate_usd": "312.40"},
     "expected": {"ok": true, "pass": true}},
    {"name": "no estimate is not a pass", "order": "pltr_buy",
     "input": {"policy": {"max_order_usd": "500"}},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "max_order_usd", "code": "POLICY_UNKNOWN"}]}},
    {"name": "malformed limit", "order": "pltr_buy",
     "input": {"policy": {"max_order_usd": "five hundred"}, "estimate_usd": "312.40"},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "max_order_usd", "code": "BAD_POLICY_VALUE"}]}},
    {"name": "concentration over the cap after the order", "order": "pltr_buy",
     "input": {"policy": {"max_symbol_pct_household": "3"}, "estimate_usd": "312.40",
               "household": {"total_usd": "14880.00", "by_symbol": {"PLTR": "238.00"}}},
     "expected": {"ok": true, "pass": false, "checks": [{"rule": "max_symbol_pct_household", "actual": "3.6%", "pass": false}],
                  "violations": [{"code": "POLICY_CAP"}]}},
    {"name": "concentration with cash in the total", "order": "pltr_buy",
     "input": {"policy": {"max_symbol_pct_household": "10"}, "estimate_usd": "312.40",
               "household": {"total_usd": "14880.00", "by_symbol": {"PLTR": "238.00"}, "includes_cash": true}},
     "expected": {"ok": true, "pass": true, "checks": [{"rule": "max_symbol_pct_household", "actual": "3.7%"}]}},
    {"name": "a sell only reduces concentration", "order": "pltr_sell",
     "input": {"policy": {"max_symbol_pct_household": "1"}, "estimate_usd": "311.80"},
     "expected": {"ok": true, "pass": true, "checks": [{"rule": "max_symbol_pct_household", "actual": "sell (reduces this symbol)", "pass": true}]}},
    {"name": "concentration without household data is unknown", "order": "pltr_buy",
     "input": {"policy": {"max_symbol_pct_household": "10"}, "estimate_usd": "312.40"},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "max_symbol_pct_household", "code": "POLICY_UNKNOWN"}]}},
    {"name": "option concentration uses chain_symbol", "order": "amd_spread",
     "input": {"policy": {"max_symbol_pct_household": "5"}, "estimate_usd": "440.00",
               "household": {"total_usd": "10000.00", "by_symbol": {"AMD": "100.00"}}},
     "expected": {"ok": true, "pass": false, "symbol": "AMD", "checks": [{"actual": "5.2%", "pass": false}]}},
    {"name": "allowlist miss", "order": "pltr_buy",
     "input": {"policy": {"symbol_allowlist": ["NVDA", "AMD"]}},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "symbol_allowlist", "code": "POLICY_DENY"}]}},
    {"name": "allowlist hit, case-insensitive", "order": "pltr_buy",
     "input": {"policy": {"symbol_allowlist": ["pltr"]}},
     "expected": {"ok": true, "pass": true}},
    {"name": "crypto pair form matches the base code", "order": "btc_buy",
     "input": {"policy": {"symbol_allowlist": ["BTC"], "allow_crypto": true, "allowed_sessions": ["regular_hours"],
                          "earnings_blackout_days": "5"}},
     "expected": {"ok": true, "pass": true, "symbol": "BTC",
                  "checks": [{"rule": "symbol_allowlist", "pass": true}, {"rule": "earnings_blackout_days", "actual": "crypto (no earnings)", "pass": true},
                             {"rule": "allow_crypto", "pass": true}, {"rule": "allowed_sessions", "actual": "crypto (no market_hours)", "pass": true}]}},
    {"name": "denylist hit", "order": "pltr_buy",
     "input": {"policy": {"symbol_denylist": ["PLTR"]}},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "symbol_denylist", "code": "POLICY_DENY", "msg": "PLTR is on your symbol denylist"}]}},
    {"name": "earnings inside the blackout (unverified counts)", "order": "pltr_buy",
     "input": {"policy": {"earnings_blackout_days": "5"}, "earnings": {"PLTR": {"date": "2026-11-18", "verified": false}}, "as_of": "2026-11-16"},
     "expected": {"ok": true, "pass": false,
                  "violations": [{"rule": "earnings_blackout_days", "code": "POLICY_DENY",
                                  "msg": "PLTR reports 2026-11-18, inside your 5-day earnings blackout; the date is unverified and counts as a hit"}]}},
    {"name": "earnings on the day itself is inside", "order": "pltr_buy",
     "input": {"policy": {"earnings_blackout_days": "0"}, "earnings": {"PLTR": {"date": "2026-11-16", "verified": true}}, "as_of": "2026-11-16"},
     "expected": {"ok": true, "pass": false}},
    {"name": "earnings just outside the blackout", "order": "pltr_buy",
     "input": {"policy": {"earnings_blackout_days": "5"}, "earnings": {"PLTR": {"date": "2026-11-22", "verified": true}}, "as_of": "2026-11-16"},
     "expected": {"ok": true, "pass": true, "checks": [{"actual": "report 2026-11-22 in 6 days"}]}},
    {"name": "a report that already happened is not a hit", "order": "pltr_buy",
     "input": {"policy": {"earnings_blackout_days": "5"}, "earnings": {"PLTR": {"date": "2026-11-10", "verified": true}}, "as_of": "2026-11-16"},
     "expected": {"ok": true, "pass": true}},
    {"name": "no scheduled report (for example an ETF)", "order": "pltr_buy",
     "input": {"policy": {"earnings_blackout_days": "5"}, "earnings": {"PLTR": {"date": null}}, "as_of": "2026-11-16"},
     "expected": {"ok": true, "pass": true, "checks": [{"actual": "no upcoming report"}]}},
    {"name": "earnings not looked up is unknown", "order": "pltr_buy",
     "input": {"policy": {"earnings_blackout_days": "5"}, "as_of": "2026-11-16"},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "earnings_blackout_days", "code": "POLICY_UNKNOWN"}]}},
    {"name": "orders per day: the limit itself is allowed", "order": "pltr_buy",
     "input": {"policy": {"max_orders_per_day": "3"}, "orders_today": 2},
     "expected": {"ok": true, "pass": true, "checks": [{"actual": 3, "pass": true}]}},
    {"name": "orders per day: one over", "order": "pltr_buy",
     "input": {"policy": {"max_orders_per_day": "3"}, "orders_today": 3},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "max_orders_per_day", "code": "POLICY_CAP"}]}},
    {"name": "orders per day: count unknown", "order": "pltr_buy",
     "input": {"policy": {"max_orders_per_day": "3"}},
     "expected": {"ok": true, "pass": false, "violations": [{"code": "POLICY_UNKNOWN"}]}},
    {"name": "options not allowed", "order": "amd_spread",
     "input": {"policy": {"allow_options": false}},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "allow_options", "code": "POLICY_DENY"}]}},
    {"name": "options allowed", "order": "amd_spread",
     "input": {"policy": {"allow_options": true}},
     "expected": {"ok": true, "pass": true}},
    {"name": "crypto not allowed", "order": "btc_buy",
     "input": {"policy": {"allow_crypto": false}},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "allow_crypto", "code": "POLICY_DENY"}]}},
    {"name": "a boolean written as text is malformed", "order": "btc_buy",
     "input": {"policy": {"allow_crypto": "no"}},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "allow_crypto", "code": "BAD_POLICY_VALUE"}]}},
    {"name": "session not allowed", "order": "pltr_buy",
     "input": {"policy": {"allowed_sessions": ["regular_hours"]}},
     "expected": {"ok": true, "pass": false, "violations": [{"rule": "allowed_sessions", "code": "POLICY_DENY"}]}},
    {"name": "an omitted session is regular_hours", "order": "pltr_sell",
     "input": {"policy": {"allowed_sessions": ["regular_hours"]}},
     "expected": {"ok": true, "pass": true, "checks": [{"actual": "regular_hours"}]}},
    {"name": "option contracts per leg over the cap", "order": "amd_spread",
     "input": {"policy": {"max_option_contracts": "1"}},
     "expected": {"ok": true, "pass": false, "checks": [{"rule": "max_option_contracts", "limit": 1, "actual": 2, "pass": false}]}},
    {"name": "ratio legs multiply the contracts", "order": "amd_ratio",
     "input": {"policy": {"max_option_contracts": "3"}},
     "expected": {"ok": true, "pass": false, "checks": [{"actual": 4, "pass": false}]}},
    {"name": "contract cap does not apply to stock", "order": "pltr_buy",
     "input": {"policy": {"max_option_contracts": "1"}},
     "expected": {"ok": true, "pass": true, "checks": [{"actual": "not an option order"}]}}
  ]
}
