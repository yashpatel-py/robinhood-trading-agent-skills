{
 "script": "wash_sale",
 "about": "classify_pnl: a get_pnl_trade_history row is a share sale only when a filled get_equity_orders sell matches it (overrides O1).",
 "cases": [
  {
   "name": "match on symbol, time, quantity and price",
   "op": "classify_pnl",
   "input": {
    "rows": [
     {
      "account_last4": "M7Q5",
      "timestamp": "2026-11-03T15:12:09Z",
      "symbol": "AMD",
      "side": "sell",
      "quantity": "10",
      "price": "120.20",
      "realized_gain": "-412.00"
     }
    ],
    "equity_orders": [
     {
      "account_last4": "M7Q5",
      "id": "o1",
      "symbol": "AMD",
      "side": "sell",
      "state": "filled",
      "cumulative_quantity": "10",
      "average_price": "120.20",
      "created_at": "2026-11-03T15:12:01Z",
      "last_transaction_at": "2026-11-03T15:12:09Z"
     }
    ]
   },
   "expected": {
    "ok": true,
    "rows": [
     {
      "classification": "equity_sale",
      "matched_order": "o1",
      "date": "2026-11-03"
     }
    ],
    "equity_sale_losses": [
     {
      "shares": "10",
      "loss_per_share": "41.20",
      "realized_usd": "-412.00"
     }
    ],
    "coverage_by_symbol": {
     "AMD": {
      "status": "complete"
     }
    }
   }
  },
  {
   "name": "an option close listed under the underlying (premium as price) does not match -> unclassified, symbol unknown",
