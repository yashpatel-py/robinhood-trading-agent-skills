{
 "script": "wash_sale",
 "about": "Date arithmetic: the 61-day calendar window on the TRADE date, do-not-buy-until = D + 31, and the first NYSE trading day on or after it. Weekends and holidays never stretch the window; settlement dates never move it. Build spec B.7.9 golden dates plus boundary cases.",
 "cases": [
  {
   "name": "spec: sale 2026-12-31 -> do-not-buy-until 2027-01-31 (Sunday) -> first trading day 2027-02-01",
   "op": "window",
   "input": {
    "date": "2026-12-31",
    "as_of": "2026-12-31"
   },
   "expected": {
    "ok": true,
    "tax_year": 2026,
    "window": {
     "start": "2026-12-01",
     "end": "2027-01-30",
     "days": 61
    },
    "do_not_buy_until": "2027-01-31",
    "first_trading_day_after": "2027-02-01"
   }
  },
  {
   "name": "spec: sale 2026-12-01 -> 2027-01-01 (holiday) -> 2027-01-04",
   "op": "window",
   "input": {
    "date": "2026-12-01",
    "as_of": "2026-12-01"
   },
   "expected": {
    "ok": true,
    "window": {
     "start": "2026-11-01",
     "end": "2026-12-31"
    },
    "do_not_buy_until": "2027-01-01",
    "first_trading_day_after": "2027-01-04"
   }
  },
  {
   "name": "spec: sale 2026-09-22 -> 2026-10-23 (a Friday, no shift)",
