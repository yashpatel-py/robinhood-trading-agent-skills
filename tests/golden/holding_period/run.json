{
 "script": "holding_period",
 "about": "Holding period: starts the day after acquisition; long-term = more than one year, so from the day after the anniversary; a lot acquired on the last day of a month is long-term from the first day of the 13th month after it (Rev. Rul. 66-7), so Feb 28 before a leap year and Feb 29 both give Mar 1 (build spec B.7.11).",
 "cases": [
  {
   "name": "spec: 2025-10-03 -> long-term from 2026-10-04 (a Sunday; first trading day 2026-10-05)",
   "op": "run",
   "input": {
    "as_of": "2026-09-22",
    "lots": [
     {
      "lot_id": "A",
      "acquired": "2025-10-03",
      "shares": "1"
     }
    ]
   },
   "expected": {
    "ok": true,
    "lots": [
     {
      "term": "short",
      "long_term_on": "2026-10-04",
      "first_trading_day_long_term": "2026-10-05",
      "days_until_long_term": 12,
      "leap_day_ambiguous": false
     }
    ]
   }
  },
  {
   "name": "spec: 2025-12-03 -> long-term from 2026-12-04; NVDA 18 days on 2026-11-16",
   "op": "run",
   "input": {
    "as_of": "2026-11-16",
    "price": "228.10",
    "lots": [
     {
      "lot_id": "N2",
      "acquired": "2025-12-03",
      "shares": "40",
      "cost_per_share": "181.50",
      "symbol": "NVDA"
     }
    ]
   },
   "expected": {
    "ok": true,
    "countdown": [
     "N2"
    ],
    "countdown_gains": [
     "N2"
    ],
    "lots": [
     {
      "term": "short",
      "long_term_on": "2026-12-04",
      "first_trading_day_long_term": "2026-12-04",
      "days_until_long_term": 18,
      "unrealized_usd": "1864.00",
      "crosses_within_horizon": true
     }
    ],
    "status_line": "NO ACTION: Dollars at stake: $1,864.00 of short-term gain in 1 lot(s) turns long-term within 45 days (next: NVDA on 2026-12-04, 18 days)"
   }
  },
  {
   "name": "spec: 2024-02-29 -> long-term from 2025-03-01 (last day of the month; Rev. Rul. 66-7)",
   "op": "run",
   "input": {
    "as_of": "2025-02-28",
    "lots": [
     {
      "lot_id": "F",
