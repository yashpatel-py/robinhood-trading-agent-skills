      "term": "short",
      "long_term_on": "2025-03-01",
      "days_until_long_term": 1,
      "leap_day_ambiguous": false
     }
    ]
   }
  },
  {
   "name": "the anniversary itself is still short-term (exactly one year is not more than one year)",
   "op": "run",
   "input": {
    "as_of": "2026-12-03",
    "lots": [
     {
      "lot_id": "N2",
      "acquired": "2025-12-03",
      "shares": "1"
     }
    ]
   },
   "expected": {
    "ok": true,
    "lots": [
     {
      "term": "short",
      "days_until_long_term": 1
     }
    ]
   }
  },
