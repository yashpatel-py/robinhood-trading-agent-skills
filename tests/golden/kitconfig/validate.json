{
  "script": "kitconfig",
  "about": "get/validate results for inline config text (no file system). UNSET stops screener and exit rules; for [policy] it means not configured.",
  "cases": [
    {"name": "screener: everything UNSET stops the run and names the keys", "op": "validate",
      "input": {"text": "[options.criteria]\nstructure = \"UNSET\"\n[options.entry]\n[options.exits]\n", "sections": ["options.criteria", "options.entry", "options.exits"]},
      "expected": {"ok": true, "valid": false, "missing": ["options.criteria.max_position_pct", "options.criteria.max_concurrent", "options.criteria.max_cost_per_contract_usd", "options.criteria.reserve_cash_usd", "options.criteria.price_min", "options.criteria.price_max", "options.criteria.min_avg_volume", "options.criteria.structure", "options.criteria.dte_min", "options.criteria.dte_max", "options.criteria.delta_min", "options.criteria.delta_max", "options.criteria.max_spread_pct", "options.criteria.min_open_interest", "options.criteria.iv_rank_min", "options.criteria.iv_rank_max", "options.criteria.earnings_policy", "options.criteria.earnings_buffer_days", "options.criteria.scan_sessions", "options.entry.entry_price_rule", "options.entry.contracts_per_entry", "options.exits.profit_target_pct", "options.exits.stop_loss_pct", "options.exits.time_stop_dte", "options.exits.max_hold_days"], "errors": []}},
    {"name": "screener: a complete debit-spread config is valid and reports what the structure needs", "op": "validate",
      "input": {"text": "[options.criteria]\nmax_position_pct = \"5\"\nmax_concurrent = \"3\"\nmax_cost_per_contract_usd = \"250\"\nreserve_cash_usd = \"500\"\nprice_min = \"10\"\nprice_max = \"200\"\nmin_avg_volume = \"1000000\"\nstructure = \"debit_call_spread\"\nspread_width_min = \"2.5\"\nspread_width_max = \"5\"\ndte_min = \"21\"\ndte_max = \"45\"\ndelta_min = \"0.30\"\ndelta_max = \"0.55\"\nmax_spread_pct = \"8\"\nmin_open_interest = \"500\"\niv_rank_min = \"OFF\"\niv_rank_max = \"OFF\"\nearnings_policy = \"avoid\"\nearnings_buffer_days = \"2\"\nscan_sessions = \"regular_hours_only\"\n[options.entry]\nentry_price_rule = \"ask_each_time\"\ncontracts_per_entry = \"1\"\n[options.exits]\nprofit_target_pct = \"50\"\nstop_loss_pct = \"40\"\ntime_stop_dte = \"7\"\nmax_hold_days = \"30\"\n", "sections": ["options.criteria", "options.entry", "options.exits"]},
      "expected": {"ok": true, "valid": true, "missing": [], "errors": [], "structure_requirements": {"structure": "debit_call_spread", "legs": 2, "option_level": "option_level_3", "account_types": ["margin", "limited_margin"], "retirement_allowed": false, "requires": ["spread_width_min", "spread_width_max"]}, "sections": {"options.criteria": {"off": ["iv_rank_min", "iv_rank_max"]}}}},
    {"name": "single-leg structure does not need spread widths", "op": "validate",
      "input": {"text": "[options.criteria]\nstructure = \"long_put\"\nspread_width_min = \"OFF\"\n", "sections": ["options.criteria"]},
      "expected": {"ok": true, "valid": false, "errors": [], "structure_requirements": {"option_level": "option_level_2", "retirement_allowed": true}}},
    {"name": "MIN_GT_MAX on every pair", "op": "validate",
      "input": {"text": "[options.criteria]\nstructure = \"debit_put_spread\"\nprice_min = \"200\"\nprice_max = \"10\"\ndte_min = \"45\"\ndte_max = \"21\"\ndelta_min = \"0.6\"\ndelta_max = \"0.3\"\nspread_width_min = \"5\"\nspread_width_max = \"2\"\niv_rank_min = \"80\"\niv_rank_max = \"20\"\n", "sections": ["options.criteria"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "MIN_GT_MAX", "fields": ["options.criteria.price_min", "options.criteria.price_max"]}, {"code": "MIN_GT_MAX", "fields": ["options.criteria.dte_min", "options.criteria.dte_max"]}, {"code": "MIN_GT_MAX", "fields": ["options.criteria.delta_min", "options.criteria.delta_max"]}, {"code": "MIN_GT_MAX", "fields": ["options.criteria.spread_width_min", "options.criteria.spread_width_max"]}, {"code": "MIN_GT_MAX", "fields": ["options.criteria.iv_rank_min", "options.criteria.iv_rank_max"]}]}},
    {"name": "equal min and max is allowed", "op": "validate",
      "input": {"text": "[options.criteria]\ndte_min = \"30\"\ndte_max = \"30\"\n", "sections": ["options.criteria"]},
      "expected": {"ok": true, "errors": []}},
    {"name": "OFF only where allowed; spreads cannot turn widths OFF", "op": "validate",
      "input": {"text": "[options.criteria]\nstructure = \"debit_call_spread\"\ndte_min = \"OFF\"\nspread_width_min = \"OFF\"\n", "sections": ["options.criteria"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "OFF_NOT_ALLOWED", "field": "options.criteria.spread_width_min"}, {"code": "OFF_NOT_ALLOWED", "field": "options.criteria.dte_min"}]}},
    {"name": "enum, decimal and range errors", "op": "validate",
      "input": {"text": "[options.criteria]\nstructure = \"iron_condor\"\ndelta_max = \"1.5\"\nmax_spread_pct = \"wide\"\nmax_concurrent = \"0\"\n", "sections": ["options.criteria"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "BAD_VALUE", "field": "options.criteria.max_concurrent"}, {"code": "BAD_ENUM", "field": "options.criteria.structure"}, {"code": "BAD_VALUE", "field": "options.criteria.delta_max"}, {"code": "BAD_VALUE", "field": "options.criteria.max_spread_pct"}]}},
    {"name": "exit rules: formats", "op": "validate",
      "input": {"text": "[exits.equity]\nstop_rule = \"atr:2.0:14\"\ntarget_rule = \"r:2\"\ntime_in_force = \"gtc\"\nbackstop_alerts = \"yes\"\n[exits.crypto]\nstop_rule = \"pct:12.5\"\ntime_in_force = \"gfw\"\n", "sections": ["exits.equity", "exits.crypto"]},
      "expected": {"ok": true, "valid": true, "missing": [], "errors": []}},
    {"name": "exit rules: bad forms", "op": "validate",
      "input": {"text": "[exits.equity]\nstop_rule = \"r:2\"\ntarget_rule = \"pct:abc\"\ntime_in_force = \"GTC\"\nbackstop_alerts = \"maybe\"\n[exits.crypto]\nstop_rule = \"atr:2:14\"\ntime_in_force = \"ioc\"\n", "sections": ["exits.equity", "exits.crypto"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "BAD_VALUE", "field": "exits.equity.stop_rule"}, {"code": "BAD_VALUE", "field": "exits.equity.target_rule"}, {"code": "BAD_ENUM", "field": "exits.equity.time_in_force"}, {"code": "BAD_ENUM", "field": "exits.equity.backstop_alerts"}, {"code": "BAD_VALUE", "field": "exits.crypto.stop_rule"}, {"code": "BAD_ENUM", "field": "exits.crypto.time_in_force"}]}},
    {"name": "per-symbol levels: stop must be below target", "op": "validate",
      "input": {"text": "[exits.equity.symbols.NVDA]\nstop = \"200.00\"\ntarget = \"195.00\"\n[exits.equity.symbols.AMD]\nstop = \"140.00\"\n", "sections": ["exits.equity.symbols"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "STOP_NOT_BELOW_TARGET", "fields": ["exits.equity.symbols.NVDA.stop", "exits.equity.symbols.NVDA.target"]}]}},
    {"name": "policy UNSET means not configured, never missing", "op": "validate",
      "input": {"text": "[policy]\nmax_order_usd = \"UNSET\"\nread_scope = \"ask\"\n", "sections": ["policy"]},
      "expected": {"ok": true, "valid": true, "missing": [], "sections": {"policy": {"present": true}}}},
    {"name": "policy value errors", "op": "validate",
      "input": {"text": "[policy]\nmax_order_usd = \"-5\"\nallow_options = \"yes\"\nallowed_sessions = [\"overnight\"]\nread_scope = \"everything\"\nsymbol_denylist = [\"GME\", \"this is not a ticker\"]\n", "sections": ["policy"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "BAD_ENUM", "field": "policy.read_scope"}, {"code": "BAD_VALUE", "field": "policy.max_order_usd"}, {"code": "BAD_VALUE", "field": "policy.symbol_denylist"}, {"code": "BAD_VALUE", "field": "policy.allow_options"}, {"code": "BAD_ENUM", "field": "policy.allowed_sessions"}]}},
    {"name": "unknown keys and sections are warnings (typo guard)", "op": "validate",
      "input": {"text": "[options.exits]\nprofit_target_pct = \"50\"\nstop_los_pct = \"40\"\n[weird]\nx = \"1\"\n"},
      "expected": {"ok": true, "valid": false, "missing": ["options.exits.stop_loss_pct", "options.exits.time_stop_dte", "options.exits.max_hold_days"], "warnings": [{"code": "UNKNOWN_SECTION", "field": "weird"}, {"code": "UNKNOWN_KEY", "field": "options.exits.stop_los_pct"}]}},
    {"name": "validate everything present when no sections are named", "op": "validate",
      "input": {"text": "[report]\nwindow_days = \"7\"\n[tax]\nlookahead_days = \"45\"\n"},
      "expected": {"ok": true, "valid": true, "sections": {"tax": {"present": true}, "report": {"present": true}}}},
    {"name": "tax related_tickers must be groups of two or more", "op": "validate",
      "input": {"text": "[tax]\nrelated_tickers = [[\"VOO\"]]\n", "sections": ["tax"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "BAD_VALUE", "field": "tax.related_tickers"}]}},
    {"name": "accounts.retirement takes 4-character endings only", "op": "validate",
      "input": {"text": "[accounts]\nretirement = [\"P0Z9\", \"123456789\"]\n", "sections": ["accounts"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "BAD_VALUE", "field": "accounts.retirement"}]}},
    {"name": "unknown section name in the request", "op": "validate",
      "input": {"text": "[report]\n", "sections": ["screener"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "UNKNOWN_SECTION", "field": "screener"}]}},
    {"name": "get: values, unset and off", "op": "get",
      "input": {"text": "[options.exits]\nprofit_target_pct = \"50\"\nstop_loss_pct = \"UNSET\"\nexit_price_rule = \"bid\"\n", "section": "options.exits"},
      "match": "exact",
      "expected": {"ok": true, "path_used": null, "source": "input", "section_name": "options.exits", "section": {"profit_target_pct": "50", "stop_loss_pct": "UNSET", "exit_price_rule": "bid"}, "unset": ["stop_loss_pct", "time_stop_dte", "max_hold_days"], "off": [], "invalid": [], "unknown_keys": [], "missing_section": false}},
    {"name": "get: a section that is not in the file", "op": "get",
      "input": {"text": "[report]\nwindow_days = \"7\"\n", "section": "policy"},
      "expected": {"ok": true, "missing_section": true, "section": {}}},
    {"name": "get: malformed values are reported as invalid", "op": "get",
      "input": {"text": "[policy]\nmax_order_usd = \"five hundred\"\n", "section": "policy"},
      "expected": {"ok": true, "invalid": [{"code": "BAD_VALUE", "field": "policy.max_order_usd"}]}},
    {"name": "get: per-symbol table", "op": "get",
      "input": {"text": "[exits.equity.symbols.NVDA]\nstop = \"195.00\"\n", "section": "exits.equity.symbols.NVDA"},
      "expected": {"ok": true, "section": {"stop": "195.00"}, "unset": ["target"]}},
    {"name": "get: the whole symbols table", "op": "get",
      "input": {"text": "[exits.equity.symbols.NVDA]\nstop = \"195.00\"\n[exits.equity.symbols.AMD]\ntarget = \"180\"\n", "section": "exits.equity.symbols"},
      "expected": {"ok": true, "section": {"NVDA": {"stop": "195.00"}, "AMD": {"target": "180"}}}},
    {"name": "get: unknown section", "op": "get",
      "input": {"text": "", "section": "screener"},
      "expected": {"ok": false, "errors": [{"code": "UNKNOWN_SECTION"}]}},
    {"name": "get: parse errors stop with the line number", "op": "get",
      "input": {"text": "[tax]\nmin_loss_usd = 1.5\n", "section": "tax"},
      "expected": {"ok": false, "errors": [{"code": "GRAMMAR", "field": "line 2"}]}},
    {"name": "JSON fallback parses the same structure", "op": "get",
      "input": {"text": "{\"options\": {\"exits\": {\"profit_target_pct\": \"50\", \"max_hold_days\": 30}}}", "section": "options.exits"},
      "expected": {"ok": true, "section": {"profit_target_pct": "50", "max_hold_days": 30}, "unset": ["stop_loss_pct", "time_stop_dte", "exit_price_rule"]}},
    {"name": "JSON fallback rejects floats", "op": "get",
      "input": {"text": "{\"tax\": {\"min_loss_usd\": 1.5}}", "section": "tax"},
      "expected": {"ok": false, "errors": [{"code": "GRAMMAR"}]}},
    {"name": "JSON fallback rejects duplicate keys", "op": "get",
      "input": {"text": "{\"tax\": {\"lookahead_days\": \"45\", \"lookahead_days\": \"30\"}}", "section": "tax"},
      "expected": {"ok": false, "errors": [{"code": "DUPLICATE"}]}},
    {"name": "JSON fallback rejects null", "op": "get",
      "input": {"text": "{\"tax\": {\"min_loss_usd\": null}}", "section": "tax"},
      "expected": {"ok": false, "errors": [{"code": "GRAMMAR"}]}},
    {"name": "config object input", "op": "get",
      "input": {"config": {"report": {"window_days": "14"}}, "section": "report"},
      "expected": {"ok": true, "source": "input", "section": {"window_days": "14"}, "unset": []}},
    {"name": "options.exits.stop_loss_pct above 100 is allowed (a short option can lose more than its premium)", "op": "validate",
      "input": {"text": "[options.exits]\nprofit_target_pct = \"50\"\nstop_loss_pct = \"200\"\ntime_stop_dte = \"7\"\nmax_hold_days = \"30\"\n", "sections": ["options.exits"]},
      "expected": {"ok": true, "valid": true, "errors": [], "missing": []}},
    {"name": "options.exits.stop_loss_pct must still be above zero", "op": "validate",
      "input": {"text": "[options.exits]\nprofit_target_pct = \"50\"\nstop_loss_pct = \"0\"\ntime_stop_dte = \"7\"\nmax_hold_days = \"30\"\n", "sections": ["options.exits"]},
      "expected": {"ok": true, "valid": false, "errors": [{"code": "BAD_VALUE", "field": "options.exits.stop_loss_pct"}]}}
  ]
}
