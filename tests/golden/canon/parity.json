{
  "script": "canon",
  "about": "K14 parity: review and place parameters that differ only in chain_symbol, underlying_type, ref_id, documented defaults, enum case, decimal format or leg/lot order must hash equal; anything that changes the order must not.",
  "cases": [
    {"name": "option: review-only keys, omitted defaults, price format and leg order", "equal": true,
     "a": {"tool": "review_option_order", "params": {"account_number": "demo-X4F1", "chain_symbol": "AMD", "underlying_type": "equity",
           "quantity": "2", "price": "1.50", "direction": "debit",
           "legs": [{"option_id": "leg-b", "side": "sell", "position_effect": "open"},
                    {"option_id": "leg-a", "side": "buy", "position_effect": "open"}]}},
     "b": {"tool": "place_option_order", "params": {"account_number": "demo-X4F1", "ref_id": "ref-1", "quantity": "2", "price": "1.5",
           "type": "limit", "time_in_force": "gfd", "market_hours": "regular_hours", "direction": "debit",
           "legs": [{"option_id": "leg-a", "side": "buy", "position_effect": "open", "ratio_quantity": 1},
                    {"option_id": "leg-b", "side": "sell", "position_effect": "open", "ratio_quantity": 1}]}}},
    {"name": "option: enum case and a stringly ratio", "equal": true,
     "a": {"tool": "review_option_order", "params": {"account_number": "demo-X4F1", "quantity": "1", "price": "2.05",
           "legs": [{"option_id": "leg-a", "side": "BUY", "position_effect": "Open", "ratio_quantity": "1"}]}},
     "b": {"tool": "place_option_order", "params": {"account_number": "demo-X4F1", "quantity": "1", "price": "2.050", "type": "LIMIT",
           "legs": [{"option_id": "leg-a", "side": "buy", "position_effect": "open", "ratio_quantity": 1}]}}},
    {"name": "equity: decimal format, symbol case, TIF case and defaults, ref_id", "equal": true,
     "a": {"tool": "review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "pltr", "side": "buy", "type": "limit",
           "quantity": "10.00", "limit_price": "31.240"}},
     "b": {"tool": "place_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "PLTR", "side": "buy", "type": "limit",
           "quantity": "10", "limit_price": "31.24", "time_in_force": "GFD", "market_hours": "regular_hours", "ref_id": "ref-2"}}},
    {"name": "equity: tax lot order and lot decimal format", "equal": true,
     "a": {"tool": "review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "TSLA", "side": "sell", "type": "limit",
           "quantity": "20", "limit_price": "262", "tax_lots": [{"open_lot_id": "L9", "quantity": "5"}, {"open_lot_id": "L7", "quantity": "15.0"}]}},
     "b": {"tool": "place_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "TSLA", "side": "sell", "type": "limit",
           "quantity": "20", "limit_price": "262.00", "tax_lots": [{"open_lot_id": "L7", "quantity": "15"}, {"open_lot_id": "L9", "quantity": "5.00"}]}}},
    {"name": "equity: a null tax_lots is the same as none", "equal": true,
     "a": {"tool": "review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "KO", "side": "sell", "type": "market",
           "quantity": "5", "tax_lots": null}},
     "b": {"tool": "place_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "KO", "side": "sell", "type": "market", "quantity": "5"}}},
    {"name": "equity: MCP-prefixed tool names", "equal": true,
     "a": {"tool": "mcp__robinhood-trading__review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "KO", "side": "buy",
           "type": "limit", "quantity": "1", "limit_price": "70"}},
     "b": {"tool": "mcp__plugin_unofficial-rh-connector_robinhood__place_equity_order", "params": {"account_number": "demo-X4F1",
           "symbol": "KO", "side": "buy", "type": "limit", "quantity": "1", "limit_price": "70.00"}}},
    {"name": "OCO: omitted regular_hours and TIF case", "equal": true,
     "a": {"tool": "review_advanced_order", "params": {"account_number": "demo-X4F1", "symbol": "amd", "side": "sell", "quantity": "10",
           "take_profit_limit_price": "180.00", "stop_loss_stop_price": "142", "time_in_force": "GTC"}},
     "b": {"tool": "place_advanced_order", "params": {"account_number": "demo-X4F1", "symbol": "AMD", "side": "sell", "quantity": "10",
           "take_profit_limit_price": "180", "stop_loss_stop_price": "142.00", "time_in_force": "gtc", "market_hours": "regular_hours", "ref_id": "ref-3"}}},
    {"name": "crypto: stop_loss day-only default", "equal": true,
     "a": {"tool": "preview_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "ETH", "side": "sell", "type": "stop_loss",
           "quantity": "0.5", "stop_price": "2000"}},
     "b": {"tool": "place_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "ETH", "side": "sell", "type": "stop_loss",
           "quantity": "0.50", "stop_price": "2000.00", "time_in_force": "gfd", "ref_id": "ref-4"}}},
    {"name": "crypto: market gtc default", "equal": true,
     "a": {"tool": "preview_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "BTC", "side": "buy", "type": "market",
           "dollar_amount": "100"}},
     "b": {"tool": "place_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "BTC", "side": "buy", "type": "market",
           "dollar_amount": "100.00", "time_in_force": "gtc"}}},

    {"name": "crypto: a GTC stop is a different order from the day-only default", "equal": false, "diff_fields": ["time_in_force"],
     "a": {"tool": "preview_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "ETH", "side": "sell", "type": "stop_loss",
           "quantity": "0.5", "stop_price": "2000"}},
     "b": {"tool": "place_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "ETH", "side": "sell", "type": "stop_loss",
           "quantity": "0.5", "stop_price": "2000", "time_in_force": "gtc"}}},
    {"name": "crypto: BTC and BTC-USD are different inputs (re-review)", "equal": false, "diff_fields": ["symbol"],
     "a": {"tool": "preview_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "BTC", "side": "buy", "type": "market", "dollar_amount": "50"}},
     "b": {"tool": "place_crypto_order", "params": {"rhs_account_number": "demo-5555", "symbol": "BTC-USD", "side": "buy", "type": "market", "dollar_amount": "50"}}},
    {"name": "option: a changed quantity", "equal": false, "diff_fields": ["quantity"],
     "a": {"tool": "review_option_order", "params": {"account_number": "demo-X4F1", "quantity": "1", "price": "2.05",
           "legs": [{"option_id": "leg-a", "side": "buy", "position_effect": "open"}]}},
     "b": {"tool": "place_option_order", "params": {"account_number": "demo-X4F1", "quantity": "2", "price": "2.05",
           "legs": [{"option_id": "leg-a", "side": "buy", "position_effect": "open"}]}}},
    {"name": "option: a changed leg side", "equal": false, "diff_fields": ["legs"],
     "a": {"tool": "review_option_order", "params": {"account_number": "demo-X4F1", "quantity": "1", "price": "2.05",
           "legs": [{"option_id": "leg-a", "side": "buy", "position_effect": "open"}]}},
     "b": {"tool": "place_option_order", "params": {"account_number": "demo-X4F1", "quantity": "1", "price": "2.05",
           "legs": [{"option_id": "leg-a", "side": "sell", "position_effect": "open"}]}}},
    {"name": "equity: a different account", "equal": false, "diff_fields": ["account_number"],
     "a": {"tool": "review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "KO", "side": "buy", "type": "limit", "quantity": "1", "limit_price": "70"}},
     "b": {"tool": "place_equity_order", "params": {"account_number": "demo-M7Q5", "symbol": "KO", "side": "buy", "type": "limit", "quantity": "1", "limit_price": "70"}}},
    {"name": "equity: a different session", "equal": false, "diff_fields": ["market_hours"],
     "a": {"tool": "review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "KO", "side": "buy", "type": "limit", "quantity": "1", "limit_price": "70"}},
     "b": {"tool": "place_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "KO", "side": "buy", "type": "limit", "quantity": "1", "limit_price": "70",
           "market_hours": "extended_hours"}}},
    {"name": "equity vs OCO are different families even with shared keys", "equal": false,
     "a": {"tool": "review_equity_order", "params": {"account_number": "demo-X4F1", "symbol": "AMD", "side": "sell", "quantity": "10"}},
     "b": {"tool": "review_advanced_order", "params": {"account_number": "demo-X4F1", "symbol": "AMD", "side": "sell", "quantity": "10"}}}
  ]
}
