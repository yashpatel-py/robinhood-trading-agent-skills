{
  "script": "exposure",
  "about": "Household concentration. Hand arithmetic: PLTR 10x31.20 + 20x31.20 = 936.00; NVDA 10x228.10 = 2281.00; AMD long call bid 3.30x100 = 330.00; BTC 0.01x60000 = 600.00; total 4147.00. With 3333.00 cash the total is 7480.00.",
  "cases": [
    {"name": "three accounts, four asset groups, proposed buy (positions-only total)", "op": "run",
     "input": {"positions": [
       {"account_last4": "X4F1", "account_type": "limited_margin", "asset_class": "equity", "symbol": "PLTR", "quantity": "10", "price": "31.20"},
       {"account_last4": "M7Q5", "account_type": "cash", "asset_class": "equity", "symbol": "PLTR", "quantity": "20", "price": "31.20"},
       {"account_last4": "M7Q5", "account_type": "cash", "asset_class": "equity", "symbol": "NVDA", "quantity": "10", "price": "228.10"},
       {"account_last4": "X4F1", "asset_class": "option", "symbol": "AMD 2026-11-27 165C", "underlying": "AMD", "side": "long", "quantity": "1", "bid": "3.30", "ask": "3.40"},
       {"account_last4": "X4F1", "asset_class": "crypto", "symbol": "BTC-USD", "quantity": "0.01", "price": "60000"}],
       "proposed": {"symbol": "PLTR", "side": "buy", "quantity": "10", "price": "31.24"}},
     "expected": {"ok": true, "household_total_usd": "4147.00", "positions_total_usd": "4147.00", "cash_total_usd": null, "complete": true,
                  "by_symbol": [
                    {"symbol": "NVDA", "value_usd": "2281.00", "pct": 55.0, "accounts": ["M7Q5"], "by_asset_class": {"equity": "2281.00"}},
                    {"symbol": "PLTR", "value_usd": "936.00", "pct": 22.6, "accounts": ["M7Q5", "X4F1"]},
                    {"symbol": "BTC", "value_usd": "600.00", "pct": 14.5, "by_asset_class": {"crypto": "600.00"}},
                    {"symbol": "AMD", "value_usd": "330.00", "pct": 8.0, "by_asset_class": {"option": "330.00"}}],
                  "by_account": [{"account_last4": "M7Q5", "value_usd": "2905.00"}, {"account_last4": "X4F1", "value_usd": "1242.00"}],
                  "by_asset_class": {"crypto": "600.00", "equity": "3217.00", "option": "330.00"},
                  "unpriced": [],
                  "proposed_after": {"symbol": "PLTR", "side": "buy", "notional_usd": "312.40", "pct_before": 22.6, "pct_after": 28.0,
                                     "value_after_usd": "1248.40"}}},
    {"name": "cash included: a buy moves cash into stock and the total stays", "op": "run",
     "input": {"positions": [
       {"account_last4": "X4F1", "asset_class": "equity", "symbol": "PLTR", "quantity": "30", "price": "31.20"},
       {"account_last4": "M7Q5", "asset_class": "equity", "symbol": "NVDA", "quantity": "10", "price": "228.10"},
       {"account_last4": "X4F1", "asset_class": "option", "underlying": "AMD", "symbol": "AMD 165C", "side": "long", "quantity": "1", "bid": "3.30"},
       {"account_last4": "X4F1", "asset_class": "crypto", "symbol": "BTC", "quantity": "0.01", "price": "60000"}],
       "cash_usd_by_account": {"X4F1": "2480.00", "M7Q5": "853.00"},
       "proposed": {"symbol": "PLTR", "side": "buy", "notional_usd": "312.40"}},
     "expected": {"ok": true, "household_total_usd": "7480.00", "positions_total_usd": "4147.00", "cash_total_usd": "3333.00",
                  "by_symbol": [{"symbol": "NVDA", "pct": 30.5}, {"symbol": "PLTR", "pct": 12.5}, {"symbol": "BTC"}, {"symbol": "AMD"}],
                  "by_account": [{"account_last4": "M7Q5", "value_usd": "3134.00"}, {"account_last4": "X4F1", "value_usd": "4346.00"}],
                  "proposed_after": {"pct_before": 12.5, "pct_after": 16.7},
                  "notes": ["options valued at bid (long) / ask (short) \u00d7 100, grouped under the underlying", "no ETF look-through",
                            "household total includes cash"]}},
    {"name": "a short call is a liability at the ask, netted under the underlying", "op": "run",
     "input": {"positions": [
       {"account_last4": "X4F1", "asset_class": "equity", "symbol": "KO", "quantity": "100", "price": "72.05"},
       {"account_last4": "X4F1", "asset_class": "option", "symbol": "KO 70C", "underlying": "KO", "side": "short", "quantity": "1", "bid": "2.20", "ask": "2.30"}]},
     "expected": {"ok": true, "household_total_usd": "6975.00",
                  "by_symbol": [{"symbol": "KO", "value_usd": "6975.00", "pct": 100.0, "by_asset_class": {"equity": "7205.00", "option": "-230.00"}}]}},
    {"name": "an unpriced position makes the result incomplete", "op": "run",
     "input": {"positions": [
       {"account_last4": "M7Q5", "asset_class": "equity", "symbol": "NVDA", "quantity": "10", "price": "228.10"},
       {"account_last4": "P0Z9", "asset_class": "equity", "symbol": "KO", "quantity": "5"}]},
     "expected": {"ok": true, "complete": false, "household_total_usd": "2281.00",
                  "unpriced": [{"symbol": "KO", "asset_class": "equity", "account_last4": "P0Z9", "why": "no price"}],
                  "by_symbol": [{"symbol": "NVDA", "pct": 100.0}],
                  "notes": ["options valued at bid (long) / ask (short) \u00d7 100, grouped under the underlying", "no ETF look-through",
                            "household total excludes cash", "1 position(s) could not be priced; percentages are incomplete"]}},
    {"name": "an option without a bid falls back to price, else it is unpriced", "op": "run",
     "input": {"positions": [
       {"account_last4": "X4F1", "asset_class": "option", "underlying": "AMD", "symbol": "AMD 165C", "side": "long", "quantity": "2", "price": "3.35"},
       {"account_last4": "X4F1", "asset_class": "option", "underlying": "AMD", "symbol": "AMD 150P", "side": "long", "quantity": "1"}]},
     "expected": {"ok": true, "household_total_usd": "670.00", "complete": false,
                  "unpriced": [{"symbol": "AMD", "asset_class": "option", "why": "no bid (or price) for this option"}]}},
    {"name": "account numbers are cut to the last four", "op": "run",
     "input": {"positions": [{"account_last4": "ACCT-X4F1", "asset_class": "equity", "symbol": "KO", "quantity": "1", "price": "70"}]},
     "expected": {"ok": true, "by_symbol": [{"accounts": ["X4F1"]}], "by_account": [{"account_last4": "X4F1"}]}},
    {"name": "a proposed sell larger than the holding", "op": "run",
     "input": {"positions": [{"account_last4": "X4F1", "asset_class": "equity", "symbol": "PLTR", "quantity": "10", "price": "31.20"}],
               "proposed": {"symbol": "PLTR", "side": "sell", "notional_usd": "500"}},
     "expected": {"ok": true, "proposed_after": {"value_after_usd": "0.00", "pct_before": 100.0}}},
    {"name": "positions are required", "op": "run", "input": {},
     "expected": {"ok": false, "errors": [{"code": "MISSING_FIELD", "field": "positions"}]}},
    {"name": "quantities are decimals", "op": "run",
     "input": {"positions": [{"account_last4": "X4F1", "symbol": "KO", "quantity": "ten", "price": "70"}]},
     "expected": {"ok": false, "errors": [{"code": "BAD_VALUE", "field": "positions[0].quantity"}]}},
    {"name": "asset class must be known", "op": "run",
     "input": {"positions": [{"account_last4": "X4F1", "asset_class": "bond", "symbol": "T", "quantity": "1", "price": "99"}]},
     "expected": {"ok": false, "errors": [{"code": "BAD_VALUE", "field": "positions[0].asset_class"}]}},
    {"name": "proposed side must be buy or sell", "op": "run",
     "input": {"positions": [{"account_last4": "X4F1", "symbol": "KO", "quantity": "1", "price": "70"}],
               "proposed": {"symbol": "KO", "side": "short", "notional_usd": "100"}},
     "expected": {"ok": false, "errors": [{"code": "BAD_VALUE", "field": "proposed.side"}]}}
  ]
}
