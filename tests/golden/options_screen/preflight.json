{"script": "options_screen",
 "about": "Structure preflight goldens (options level, account type, retirement, agentic, funding, routes). Hand-written from connector-rules R16 and the get_option_level_upgrade_info / get_limited_margin_upgrade_info descriptions.",
 "cases": [
  {"name": "long call on limited margin L3, funded: allowed", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "limited_margin", "option_level": "option_level_3", "retirement": false, "agentic_allowed": true}, "funding": {"buying_power_usd": "2480.00", "max_cost_per_contract_usd": "700.00", "contracts_per_entry": "1", "reserve_cash_usd": "200.00"}}, "expected": {"ok": true, "allowed": true, "stop": null, "route": [], "notes": []}},
  {"name": "long put on a cash L2 account: allowed, with the settlement note", "op": "preflight", "input": {"structure": "long_put", "account": {"type": "cash", "option_level": "option_level_2", "retirement": false, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": true, "stop": null, "route": [], "notes": ["cash account: option trades settle T+1; buying again with unsettled proceeds risks a good-faith violation, and 5 in 12 months trigger a 90-day restriction"]}},
  {"name": "long call with an empty options level: level upgrade route", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "cash", "option_level": "", "retirement": false, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "OPTIONS_LEVEL"}, "route": ["get_option_level_upgrade_info"]}},
  {"name": "long call with option_level_0: no options access", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "margin", "option_level": "option_level_0", "retirement": false, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "OPTIONS_LEVEL"}, "route": ["get_option_level_upgrade_info"]}},
  {"name": "long call with option_level null: no options access", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "margin", "option_level": null, "retirement": false, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "OPTIONS_LEVEL"}}},
  {"name": "debit call spread on cash L2: limited margin first, then the level", "op": "preflight", "input": {"structure": "debit_call_spread", "account": {"type": "cash", "option_level": "option_level_2", "retirement": false, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "ACCOUNT_TYPE"}, "route": ["get_limited_margin_upgrade_info", "user completes the limited-margin upgrade", "re-fetch get_accounts", "get_option_level_upgrade_info (only if the re-read level is still below option_level_3)"]}},
  {"name": "debit call spread on cash with L3 already: limited margin only", "op": "preflight", "input": {"structure": "debit_call_spread", "account": {"type": "cash", "option_level": "option_level_3", "retirement": false, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "ACCOUNT_TYPE"}, "route": ["get_limited_margin_upgrade_info", "user completes the limited-margin upgrade", "re-fetch get_accounts"]}},
  {"name": "debit put spread on margin L2: level upgrade only", "op": "preflight", "input": {"structure": "debit_put_spread", "account": {"type": "margin", "option_level": "option_level_2", "retirement": false, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "OPTIONS_LEVEL"}, "route": ["get_option_level_upgrade_info"]}},
  {"name": "debit put spread on a retirement account: unavailable, no route", "op": "preflight", "input": {"structure": "debit_put_spread", "account": {"type": "margin", "option_level": "option_level_3", "retirement": true, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "RETIREMENT_ACCOUNT"}, "route": []}},
  {"name": "spread with unknown retirement status stops until confirmed", "op": "preflight", "input": {"structure": "debit_call_spread", "account": {"type": "limited_margin", "option_level": "option_level_3", "retirement": null, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "RETIREMENT_UNKNOWN"}, "route": []}},
  {"name": "single leg with unknown retirement status is fine", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "limited_margin", "option_level": "option_level_2", "retirement": null, "agentic_allowed": true}}, "expected": {"ok": true, "allowed": true, "stop": null}},
  {"name": "a non-agentic account is never screened for tickets", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "margin", "option_level": "option_level_3", "retirement": false, "agentic_allowed": false}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "NOT_AGENTIC_ACCOUNT"}}},
  {"name": "not funded: 500.00 < 400.00 x 1 + 200.00", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "limited_margin", "option_level": "option_level_3", "retirement": false, "agentic_allowed": true}, "funding": {"buying_power_usd": "500.00", "max_cost_per_contract_usd": "400.00", "contracts_per_entry": "1", "reserve_cash_usd": "200.00"}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "NOT_FUNDED"}}},
  {"name": "funded at exactly the need: 900.00 = 350.00 x 2 + 200.00", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "limited_margin", "option_level": "option_level_3", "retirement": false, "agentic_allowed": true}, "funding": {"buying_power_usd": "900.00", "max_cost_per_contract_usd": "350.00", "contracts_per_entry": "2", "reserve_cash_usd": "200.00"}}, "expected": {"ok": true, "allowed": true, "stop": null}},
  {"name": "capability stop wins over a funding stop; both checks listed", "op": "preflight", "input": {"structure": "debit_call_spread", "account": {"type": "cash", "option_level": "option_level_2", "retirement": false, "agentic_allowed": true}, "funding": {"buying_power_usd": "100.00", "max_cost_per_contract_usd": "400.00", "contracts_per_entry": "1", "reserve_cash_usd": "200.00"}}, "expected": {"ok": true, "allowed": false, "stop": {"code": "ACCOUNT_TYPE"}, "checks": [{"check": "agentic_account", "pass": true}, {"check": "options_level", "pass": false}, {"check": "account_type", "pass": false}, {"check": "retirement", "pass": true}, {"check": "funding", "pass": false}]}},
  {"name": "bad account type is an input error", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "ira", "option_level": "option_level_2"}}, "expected": {"ok": false, "errors": [{"code": "BAD_VALUE", "field": "account.type"}]}},
  {"name": "unknown structure is an input error", "op": "preflight", "input": {"structure": "iron_condor", "account": {"type": "limited_margin", "option_level": "option_level_3", "retirement": false, "agentic_allowed": true}}, "expected": {"ok": false, "errors": [{"code": "BAD_VALUE", "field": "structure"}]}},
  {"name": "unreadable options level is an input error", "op": "preflight", "input": {"structure": "long_call", "account": {"type": "margin", "option_level": "level_two", "retirement": false, "agentic_allowed": true}}, "expected": {"ok": false, "errors": [{"code": "BAD_VALUE", "field": "account.option_level"}]}}
 ]}
