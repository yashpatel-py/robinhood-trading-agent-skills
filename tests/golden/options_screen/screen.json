{"script": "options_screen",
 "about": "Screen goldens, hand-computed from the owner's formula tables (synthetic fixture numbers: AMD 161.40; as_of 2026-11-16). Each case's input is `base` with `patch` applied (top-level keys replaced, criteria merged key by key) and `remove` keys dropped. Expected values are subsets: every listed key must match exactly, and lists must match in length and order.",
 "base": {"as_of": "2026-11-16", "in_regular_session": true, "criteria": {"max_position_pct": "30", "max_concurrent": "3", "max_cost_per_contract_usd": "700.00", "reserve_cash_usd": "200.00", "price_min": "20.00", "price_max": "700.00", "min_avg_volume": "1000000", "symbols_allowlist": [], "symbols_blocklist": [], "structure": "long_call", "spread_width_min": "OFF", "spread_width_max": "OFF", "dte_min": "14", "dte_max": "45", "delta_min": "0.30", "delta_max": "0.60", "max_spread_pct": "5", "min_open_interest": "100", "iv_rank_min": "OFF", "iv_rank_max": "OFF", "earnings_policy": "avoid", "earnings_buffer_days": "2", "scan_sessions": "regular_hours_only", "sort_by": "required_move_pct"}, "entry": {"entry_price_rule": "natural", "contracts_per_entry": "1"}, "exits": {"profit_target_pct": "50", "stop_loss_pct": "40", "time_stop_dte": "7", "max_hold_days": "30"}, "account": {"total_value_usd": "4100.00", "buying_power_usd": "2480.00", "open_option_positions": 1, "type": "limited_margin"}, "underlyings": {"AMD": {"price": "161.40", "avg_volume": "45000000"}}, "contracts": [{"option_id": "amd-1218-165c", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 1200}], "earnings": {"AMD": {"reports": [{"date": "2026-11-03", "timing": "pm", "verified": true}, {"date": "2027-01-27", "timing": "pm", "verified": false}]}}},
 "cases": [
  {"name": "spec long call: AMD 165C at 6.30, spot 161.40 -> breakeven 171.30, +6.1%", "op": "screen", "patch": {}, "expected": {"ok": true, "status": "candidates", "report_status": "POSSIBLE", "report_only": false, "status_line": "POSSIBLE: 1 candidate matched your criteria (nothing placed) · Dollars at stake: $630.00 AMD 2026-12-18 165C (max loss per entry at the natural price)", "candidates": [{"rank": 1, "label": "AMD 2026-12-18 165C", "dte": 32, "underlying_price": "161.40", "natural_price": "6.30", "natural_label": "worst-case natural price (the ask): analysis only", "cost_per_contract_usd": "630.00", "cost_usd": "630.00", "max_loss_usd": "630.00", "max_gain_usd": null, "max_gain_unlimited": true, "breakeven": "171.30", "required_move_pct": 6.1, "spread_pct": 3.2, "account_pct": 15.4, "limit_price_by_rule": "6.30", "needs_user_price": false, "ticket_allowed": true, "exits": {"basis_price": "6.30", "profit_target_price": "9.45", "stop_price": "3.78", "time_stop_date": "2026-12-11", "hard_exit_date": "2026-12-16"}, "earnings": {"window": ["2026-11-14", "2026-12-20"], "in_window": [], "next_listed": {"date": "2027-01-27", "timing": "pm", "verified": false}}, "flags": [], "order_params": {"legs": [{"option_id": "amd-1218-165c", "side": "buy", "position_effect": "open", "ratio_quantity": 1}], "quantity": "1", "type": "limit", "price": "6.30", "time_in_force": "gfd", "market_hours": "regular_hours", "chain_symbol": "AMD", "underlying_type": "equity"}, "lint_provenance": {"quantity": "user_config", "price": "user_config"}}], "rejected": [], "next_fetch": {"chains": [], "earnings": []}}},
  {"name": "two contracts per entry double cost and account % but not the per-contract cap", "op": "screen", "patch": {"criteria": {"max_position_pct": "40"}, "entry": {"entry_price_rule": "natural", "contracts_per_entry": "2"}}, "expected": {"ok": true, "status": "candidates", "candidates": [{"cost_per_contract_usd": "630.00", "cost_usd": "1260.00", "max_loss_usd": "1260.00", "account_pct": 30.7, "contracts": "2", "order_params": {"quantity": "2"}}]}},
  {"name": "two contracts per entry: 1260 of 4100 = 30.7% fails a 30% cap", "op": "screen", "patch": {"entry": {"entry_price_rule": "natural", "contracts_per_entry": "2"}}, "expected": {"ok": true, "status": "no_candidates", "rejected": [{"label": "AMD 2026-12-18 165C", "reasons": ["ACCOUNT_PCT 30.7 > 30"]}]}},
  {"name": "long put 155P at 4.20: breakeven 150.80, move -6.6%, max gain to $0 = 15080.00", "op": "screen", "patch": {"criteria": {"structure": "long_put"}, "contracts": [{"option_id": "amd-1218-155p", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "put", "strike": "155", "expiration": "2026-12-18", "bid": "4.00", "ask": "4.20", "delta": "-0.35", "open_interest": 700}]}, "expected": {"ok": true, "status": "candidates", "candidates": [{"label": "AMD 2026-12-18 155P", "breakeven": "150.80", "required_move_pct": -6.6, "cost_usd": "420.00", "max_gain_usd": "15080.00", "max_gain_unlimited": false, "spread_pct": 4.9}]}},
  {"name": "debit call spread 0.80 on a 1.00 width risks 80 to make 20", "op": "screen", "patch": {"criteria": {"structure": "debit_call_spread", "spread_width_min": "1", "spread_width_max": "1", "delta_min": "0.20", "max_spread_pct": "10"}, "contracts": [{"option_id": "x-l", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165", "expiration": "2026-12-18", "bid": "2.50", "ask": "2.60", "delta": "0.40", "open_interest": 500}, {"option_id": "x-s", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "166", "expiration": "2026-12-18", "bid": "1.80", "ask": "1.90", "delta": "0.35", "open_interest": 500}]}, "expected": {"ok": true, "status": "candidates", "candidates": [{"label": "AMD 2026-12-18 165/166C debit call spread", "natural_price": "0.80", "natural_label": "worst-case natural price (long ask − short bid): analysis only", "width": "1.00", "cost_usd": "80.00", "max_loss_usd": "80.00", "max_gain_usd": "20.00", "breakeven": "165.80", "required_move_pct": 2.7, "risk_reward": {"risk_usd": "80.00", "reward_usd": "20.00", "reward_per_dollar_risked": 0.25}, "spread_pct": 5.4, "order_params": {"direction": "debit", "price": "0.80", "legs": [{"option_id": "x-l", "side": "buy", "position_effect": "open", "ratio_quantity": 1}, {"option_id": "x-s", "side": "sell", "position_effect": "open", "ratio_quantity": 1}]}}], "rejected": [{"label": "AMD 2026-12-18 166C (as long leg)", "reasons": ["NO_SHORT_LEG_IN_WIDTH no call strike above 166 within width 1.00-1.00 on 2026-12-18 in the fetched chain"]}]}},
  {"name": "debit put spread 160/155 at 1.90 net: breakeven 158.10, -2.0%, 1.63 per $1", "op": "screen", "patch": {"criteria": {"structure": "debit_put_spread", "spread_width_min": "5", "spread_width_max": "5", "delta_min": "0.20", "max_spread_pct": "10"}, "contracts": [{"option_id": "p160", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "put", "strike": "160", "expiration": "2026-12-18", "bid": "4.80", "ask": "5.00", "delta": "-0.45", "open_interest": 800}, {"option_id": "p155", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "put", "strike": "155", "expiration": "2026-12-18", "bid": "3.10", "ask": "3.30", "delta": "-0.33", "open_interest": 600}]}, "expected": {"ok": true, "status": "candidates", "candidates": [{"label": "AMD 2026-12-18 160/155P debit put spread", "natural_price": "1.90", "width": "5.00", "cost_usd": "190.00", "max_gain_usd": "310.00", "breakeven": "158.10", "required_move_pct": -2.0, "risk_reward": {"reward_per_dollar_risked": 1.63}, "exits": {"profit_target_price": "2.85", "stop_price": "1.14"}}]}},
  {"name": "a short leg below the open-interest floor rejects the pair", "op": "screen", "patch": {"criteria": {"structure": "debit_call_spread", "spread_width_min": "5", "spread_width_max": "5"}, "contracts": [{"option_id": "l", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "delta": "0.45", "open_interest": 1200}, {"option_id": "s", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "170", "expiration": "2026-12-18", "bid": "4.20", "ask": "4.30", "delta": "0.36", "open_interest": 40}]}, "expected": {"ok": true, "status": "no_candidates", "report_status": "NO ACTION", "rejected": [{"label": "AMD 2026-12-18 165/170C debit call spread", "reasons": ["SHORT_LEG_OPEN_INTEREST 40 < 100"], "option_id": "l", "short_option_id": "s"}, {"label": "AMD 2026-12-18 170C (as long leg)", "reasons": ["OPEN_INTEREST 40 < 100"]}]}},
  {"name": "net debit at or above the width has no max gain", "op": "screen", "patch": {"criteria": {"structure": "debit_call_spread", "spread_width_min": "1", "spread_width_max": "1", "max_spread_pct": "20"}, "contracts": [{"option_id": "l", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165", "expiration": "2026-12-18", "bid": "2.50", "ask": "2.60", "delta": "0.40", "open_interest": 500}, {"option_id": "s", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "166", "expiration": "2026-12-18", "bid": "1.55", "ask": "1.70", "delta": "0.10", "open_interest": 500}]}, "expected": {"ok": true, "status": "no_candidates", "rejected": [{"label": "AMD 2026-12-18 165/166C debit call spread", "reasons": ["NO_MAX_GAIN net debit 1.05 >= width 1.00: no expiration price makes money"], "short_option_id": "s"}, {"label": "AMD 2026-12-18 166C (as long leg)", "reasons": ["DELTA_OUT_OF_RANGE |0.10| not in 0.30-0.60"]}]}},
  {"name": "a crossed short-leg quote is unusable (QUOTE_UNAVAILABLE on the short leg)", "op": "screen", "patch": {"criteria": {"structure": "debit_call_spread", "spread_width_min": "1", "spread_width_max": "1", "max_spread_pct": "20"}, "contracts": [{"option_id": "l", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165", "expiration": "2026-12-18", "bid": "2.50", "ask": "2.60", "delta": "0.40", "open_interest": 500}, {"option_id": "s", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "166", "expiration": "2026-12-18", "bid": "2.70", "ask": "2.65", "delta": "0.10", "open_interest": 500}]}, "expected": {"ok": true, "status": "no_candidates", "report_status": "UNKNOWN", "rejected": [{"label": "AMD 2026-12-18 165/166C debit call spread", "reasons": ["SHORT_LEG_QUOTE_UNAVAILABLE bid 2.70 / ask 2.65"], "short_option_id": "s"}, {"label": "AMD 2026-12-18 166C (as long leg)", "reasons": ["QUOTE_UNAVAILABLE bid 2.70 / ask 2.65", "DELTA_OUT_OF_RANGE |0.10| not in 0.30-0.60"]}]}},
  {"name": "spread target above the width is flagged", "op": "screen", "patch": {"criteria": {"structure": "debit_call_spread", "spread_width_min": "5", "spread_width_max": "5"}, "exits": {"profit_target_pct": "100", "stop_loss_pct": "40", "time_stop_dte": "7", "max_hold_days": "30"}, "contracts": [{"option_id": "l", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "160", "expiration": "2026-12-18", "bid": "8.60", "ask": "8.80", "delta": "0.55", "open_interest": 2100}, {"option_id": "s", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "delta": "0.45", "open_interest": 1200}]}, "expected": {"ok": true, "status": "candidates", "candidates": [{"natural_price": "2.70", "exits": {"profit_target_price": "5.40"}, "flags": ["TARGET_ABOVE_MAX_VALUE"]}]}},
  {"name": "no delta: DELTA_OI_UNAVAILABLE and the report is UNKNOWN, not NO ACTION", "op": "screen", "patch": {"contracts": [{"option_id": "amd-1218-165c", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "open_interest": 1200}]}, "expected": {"ok": true, "status": "no_candidates", "report_status": "UNKNOWN", "status_line": "UNKNOWN: 0 candidates; 1 of 1 contract could not be checked (DELTA_OI_UNAVAILABLE) · Dollars at stake: none found", "counts_by_reason": {"DELTA_OI_UNAVAILABLE": 1}, "rejected": [{"label": "AMD 2026-12-18 165C", "reasons": ["DELTA_OI_UNAVAILABLE delta missing from the quote"]}]}},
  {"name": "no open interest: DELTA_OI_UNAVAILABLE", "op": "screen", "patch": {"contracts": [{"option_id": "amd-1218-165c", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "delta": "0.4512"}]}, "expected": {"ok": true, "status": "no_candidates", "rejected": [{"label": "AMD 2026-12-18 165C", "reasons": ["DELTA_OI_UNAVAILABLE open_interest missing from the quote"]}]}},
  {"name": "neither: one combined reason", "op": "screen", "patch": {"contracts": [{"option_id": "amd-1218-165c", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30"}]}, "expected": {"ok": true, "status": "no_candidates", "rejected": [{"label": "AMD 2026-12-18 165C", "reasons": ["DELTA_OI_UNAVAILABLE delta and open_interest missing from the quote"]}]}},
  {"name": "missing data plus a real failure is a real reject (NO ACTION)", "op": "screen", "patch": {"contracts": [{"option_id": "amd-1218-165c", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-12-18", "bid": "5.00", "ask": "6.30", "open_interest": 1200}]}, "expected": {"ok": true, "report_status": "NO ACTION", "rejected": [{"label": "AMD 2026-12-18 165C", "reasons": ["SPREAD_PCT 23.0 > 5", "DELTA_OI_UNAVAILABLE delta missing from the quote"]}]}},
  {"name": "no ask: QUOTE_UNAVAILABLE and no cost gates", "op": "screen", "patch": {"contracts": [{"option_id": "amd-1218-165c", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-12-18", "delta": "0.4512", "open_interest": 1200}]}, "expected": {"ok": true, "report_status": "UNKNOWN", "rejected": [{"label": "AMD 2026-12-18 165C", "reasons": ["QUOTE_UNAVAILABLE bid None / ask None"]}]}},
  {"name": "spread exactly 5.0% passes; 5.5% fails", "op": "screen", "patch": {"contracts": [{"option_id": "a", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165", "expiration": "2026-12-18", "bid": "1.95", "ask": "2.05", "delta": "0.4512", "open_interest": 1200}, {"option_id": "b", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "170", "expiration": "2026-12-18", "bid": "1.94", "ask": "2.05", "delta": "0.4512", "open_interest": 1200}]}, "expected": {"ok": true, "candidates": [{"label": "AMD 2026-12-18 165C", "spread_pct": 5.0}], "rejected": [{"label": "AMD 2026-12-18 170C", "reasons": ["SPREAD_PCT 5.5 > 5"]}]}},
  {"name": "open interest exactly at the floor passes; one below fails", "op": "screen", "patch": {"contracts": [{"option_id": "a", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 100}, {"option_id": "b", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "170", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 99}]}, "expected": {"ok": true, "candidates": [{"label": "AMD 2026-12-18 165C"}], "rejected": [{"label": "AMD 2026-12-18 170C", "reasons": ["OPEN_INTEREST 99 < 100"]}]}},
  {"name": "DTE window is inclusive: 14 passes, 13 fails, 45 passes, 46 fails", "op": "screen", "patch": {"contracts": [{"option_id": "d14", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-11-30", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 1200}, {"option_id": "d13", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-11-29", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 1200}, {"option_id": "d45", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-12-31", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 1200}, {"option_id": "d46", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2027-01-01", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 1200}]}, "expected": {"ok": true, "counts": {"candidates": 2}, "rejected": [{"label": "AMD 2026-11-29 165C", "reasons": ["DTE_OUT_OF_RANGE 13 not in 14-45"]}, {"label": "AMD 2027-01-01 165C", "reasons": ["DTE_OUT_OF_RANGE 46 not in 14-45"]}]}},
  {"name": "a contract at or inside the time stop would fire it on entry", "op": "screen", "patch": {"criteria": {"dte_min": "5"}, "contracts": [{"option_id": "d7", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-11-23", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 1200}, {"option_id": "d8", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "call", "strike": "165.0000", "expiration": "2026-11-24", "bid": "6.10", "ask": "6.30", "delta": "0.4512", "open_interest": 1200}]}, "expected": {"ok": true, "candidates": [{"dte": 8}], "rejected": [{"label": "AMD 2026-11-23 165C", "reasons": ["INSIDE_TIME_STOP DTE 7 <= time_stop_dte 7 (your time stop would fire on entry)"]}]}},
  {"name": "delta band is inclusive on |delta|; puts use the absolute value", "op": "screen", "patch": {"criteria": {"structure": "long_put"}, "contracts": [{"option_id": "p1", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "put", "strike": "160", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "delta": "-0.30", "open_interest": 1200}, {"option_id": "p2", "symbol": "AMD", "chain_symbol": "AMD", "underlying_type": "equity", "type": "put", "strike": "150", "expiration": "2026-12-18", "bid": "6.10", "ask": "6.30", "delta": "-0.29", "open_interest": 1200}]}, "expected": {"ok": true, "candidates": [{"label": "AMD 2026-12-18 160P"}], "rejected": [{"label": "AMD 2026-12-18 150P", "reasons": ["DELTA_OUT_OF_RANGE |0.29| not in 0.30-0.60"]}]}},
  {"name": "cost cap is checked at the natural price (630 > 625), not the mid (620)", "op": "screen", "patch": {"criteria": {"max_cost_per_contract_usd": "625.00"}, "entry": {"entry_price_rule": "mid", "contracts_per_entry": "1"}}, "expected": {"ok": true, "status": "no_candidates", "rejected": [{"label": "AMD 2026-12-18 165C", "reasons": ["COST_PER_CONTRACT 630.00 > 625.00"]}]}},
  {"name": "account %: 630 of 2000 = 31.5% > 30", "op": "screen", "patch": {"account": {"total_value_usd": "2000.00", "buying_power_usd": "2000.00", "open_option_positions": 0}}, "expected": {"ok": true, "rejected": [{"label": "AMD 2026-12-18 165C", "reasons": ["ACCOUNT_PCT 31.5 > 30"]}]}},
